<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.ApolloMobile" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/secondary_three</item>
        <item name="android:windowBackground">@color/neutral_white</item>
        <item name="android:statusBarColor">@color/neutral_white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/neutral_white</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowAnimationStyle">@style/ApolloWindowAnimation</item>
    </style>

    <style name="Theme.ApolloMobile" parent="Base.Theme.ApolloMobile" />

    <style name="ApolloWindowAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/screen_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/screen_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/screen_pop_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/screen_pop_exit</item>
    </style>

    <style name="ShapeAppearanceOverlay.App.CornerSize50Percent" parent="">
        <item name="cornerSize">50%</item>
    </style>
</resources>
