<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Escala tipográfica do Apollo -->

    <!-- ===== TEXTO BASE ===== -->
    <style name="apollo_text_base">
        <item name="android:textColor">@color/neutral_black</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- ===== DISPLAY ===== -->

    <style name="apollo_display1" parent="apollo_text_base">
        <item name="android:fontFamily">@font/plusjakartasans_bold</item>
        <item name="android:textSize">@dimen/text_56</item>
    </style>

    <style name="apollo_display2" parent="apollo_text_base">
        <item name="android:fontFamily">@font/plusjakartasans_bold</item>
        <item name="android:textSize">@dimen/text_40</item>
    </style>

    <!-- ===== HEADING ===== -->

    <style name="apollo_h1" parent="apollo_text_base">
        <item name="android:fontFamily">@font/plusjakartasans_bold</item>
        <item name="android:textSize">@dimen/text_48</item>
    </style>

    <style name="apollo_h2" parent="apollo_text_base">
        <item name="android:fontFamily">@font/plusjakartasans_bold</item>
        <item name="android:textSize">@dimen/text_36</item>
    </style>

    <style name="apollo_h3" parent="apollo_text_base">
        <item name="android:fontFamily">@font/plusjakartasans_bold</item>
        <item name="android:textSize">@dimen/text_32</item>
    </style>

    <style name="apollo_h4" parent="apollo_text_base">
        <item name="android:fontFamily">@font/plusjakartasans_bold</item>
        <item name="android:textSize">@dimen/text_28</item>
    </style>

    <style name="apollo_h5" parent="apollo_text_base">
        <item name="android:fontFamily">@font/plusjakartasans_bold</item>
        <item name="android:textSize">@dimen/text_24</item>
    </style>

    <style name="apollo_h6" parent="apollo_text_base">
        <item name="android:fontFamily">@font/plusjakartasans_bold</item>
        <item name="android:textSize">@dimen/text_20</item>
    </style>

    <!-- ===== BODY ===== -->

    <style name="apollo_body1" parent="apollo_text_base">
        <item name="android:fontFamily">@font/manrope_regular</item>
        <item name="android:textSize">@dimen/text_18</item>
    </style>

    <style name="apollo_body2" parent="apollo_text_base">
        <item name="android:fontFamily">@font/manrope_regular</item>
        <item name="android:textSize">@dimen/text_16</item>
    </style>

    <style name="apollo_body3" parent="apollo_text_base">
        <item name="android:fontFamily">@font/manrope_regular</item>
        <item name="android:textSize">@dimen/text_14</item>
    </style>

    <style name="apollo_body4" parent="apollo_text_base">
        <item name="android:fontFamily">@font/manrope_regular</item>
        <item name="android:textSize">@dimen/text_12</item>
    </style>

    <style name="apollo_body5" parent="apollo_text_base">
        <item name="android:fontFamily">@font/manrope_regular</item>
        <item name="android:textSize">@dimen/text_10</item>
    </style>

    <!-- ===== LABEL ===== -->

    <style name="apollo_label1" parent="apollo_text_base">
        <item name="android:fontFamily">@font/manrope_bold</item>
        <item name="android:textSize">@dimen/text_18</item>
    </style>

    <style name="apollo_label2" parent="apollo_text_base">
        <item name="android:fontFamily">@font/manrope_bold</item>
        <item name="android:textSize">@dimen/text_16</item>
    </style>

    <style name="apollo_label3" parent="apollo_text_base">
        <item name="android:fontFamily">@font/manrope_bold</item>
        <item name="android:textSize">@dimen/text_14</item>
    </style>

    <style name="apollo_label4" parent="apollo_text_base">
        <item name="android:fontFamily">@font/manrope_bold</item>
        <item name="android:textSize">@dimen/text_12</item>
    </style>

    <style name="apollo_label5" parent="apollo_text_base">
        <item name="android:fontFamily">@font/manrope_bold</item>
        <item name="android:textSize">@dimen/text_10</item>
    </style>

    <style name="apollo_label6" parent="apollo_text_base">
        <item name="android:fontFamily">@font/manrope_bold</item>
        <item name="android:textSize">@dimen/text_8</item>
    </style>

    <!-- ===== CAPTION ===== -->

    <style name="apollo_caption" parent="apollo_text_base">
        <item name="android:fontFamily">@font/manrope_regular</item>
        <item name="android:textSize">@dimen/text_8</item>
    </style>


    <style name="apollo_tag" parent="apollo_label4">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/space_20</item>
        <item name="android:background">@drawable/bg_tag</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingStart">@dimen/space_10</item>
        <item name="android:paddingEnd">@dimen/space_10</item>
    </style>

    <style name="apollo_tag_small" parent="apollo_label5">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/space_20</item>
        <item name="android:background">@drawable/bg_tag_small</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingStart">@dimen/space_8</item>
        <item name="android:paddingEnd">@dimen/space_8</item>
        <item name="android:textColor">@color/neutral_white</item>
    </style>

    <style name="apollo_cta_outline" parent="apollo_label4">
        <item name="android:layout_width">@dimen/cta_width</item>
        <item name="android:layout_height">@dimen/cta_height</item>
        <item name="android:background">@drawable/bg_cta_outline</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:textColor">@color/secondary_one</item>
    </style>

    <style name="apollo_button_primary" parent="apollo_label2">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/button_primary_height</item>
        <item name="android:background">@drawable/bg_cta_filled</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:textColor">@color/neutral_white</item>
    </style>

    <style name="apollo_button_outline" parent="apollo_label2">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/button_primary_height</item>
        <item name="android:background">@drawable/bg_cta_outline</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:textColor">@color/secondary_one</item>
    </style>

    <style name="apollo_progress" parent="Widget.Material3.LinearProgressIndicator">
        <item name="trackThickness">@dimen/space_11</item>
        <item name="trackCornerRadius">@dimen/space_6</item>
        <item name="trackColor">@color/disable_gray</item>
        <item name="indicatorTrackGapSize">0dp</item>
        <item name="trackStopIndicatorSize">0dp</item>
    </style>

    <style name="apollo_back" parent="apollo_label3">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:drawableStart">@drawable/ic_arrow_back</item>
        <item name="android:drawablePadding">@dimen/space_4</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingTop">@dimen/space_6</item>
        <item name="android:paddingBottom">@dimen/space_6</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:text">Voltar</item>
    </style>

    <style name="apollo_field_label" parent="apollo_label2">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_16</item>
    </style>

    <style name="apollo_field" parent="apollo_label4">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/space_36</item>
        <item name="android:layout_marginTop">@dimen/space_5</item>
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:paddingStart">@dimen/space_16</item>
        <item name="android:paddingEnd">@dimen/space_16</item>
        <item name="android:textColor">@color/neutral_gray</item>
        <item name="android:textColorHint">@color/disable_gray</item>
    </style>

    <style name="apollo_info_box" parent="apollo_body4">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_info_box</item>
        <item name="android:padding">@dimen/space_16</item>
        <item name="android:lineSpacingExtra">@dimen/space_2</item>
    </style>

    <style name="apollo_switch">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:thumb">@drawable/switch_thumb</item>
        <item name="track">@drawable/switch_track</item>
        <item name="thumbTint">@null</item>
        <item name="trackTint">@null</item>
        <item name="android:thumbTint">@null</item>
        <item name="android:trackTint">@null</item>
        <item name="android:background">@null</item>
        <item name="android:minHeight">@dimen/space_36</item>
        <item name="android:paddingVertical">@dimen/space_2</item>
        <item name="switchMinWidth">@dimen/space_55</item>
        <item name="showText">false</item>
    </style>

    <style name="apollo_radio">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@null</item>
        <item name="android:button">@drawable/radio_apollo</item>
        <item name="buttonTint">@null</item>
        <item name="android:buttonTint">@null</item>
        <item name="useMaterialThemeColors">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
    </style>

    <style name="apollo_filter_chip" parent="apollo_label3">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/space_30</item>
        <item name="android:background">@drawable/bg_filter_chip</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingStart">@dimen/space_16</item>
        <item name="android:paddingEnd">@dimen/space_16</item>
        <item name="android:textColor">@color/selector_filter_text</item>
        <item name="android:layout_marginEnd">@dimen/space_4</item>
    </style>

    <style name="apollo_search_pill">
        <item name="android:layout_width">@dimen/space_224</item>
        <item name="android:layout_height">@dimen/space_36</item>
        <item name="android:background">@drawable/bg_pill_outline</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">@dimen/space_16</item>
        <item name="android:paddingEnd">@dimen/space_12</item>
    </style>

    <style name="apollo_cta_filled" parent="apollo_cta_outline">
        <item name="android:background">@drawable/bg_cta_filled</item>
        <item name="android:textColor">@color/neutral_white</item>
    </style>
</resources>