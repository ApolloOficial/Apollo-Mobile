<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/space_16"
    android:paddingTop="@dimen/space_8"
    android:paddingEnd="@dimen/space_24"
    android:paddingBottom="@dimen/space_8">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_user"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.37" />

    <LinearLayout
        android:id="@+id/llUserBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chat_user"
        android:minWidth="@dimen/space_120"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_20"
        android:paddingTop="@dimen/space_16"
        android:paddingEnd="@dimen/space_20"
        android:paddingBottom="@dimen/space_12"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="@id/guideline_user"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvUserMessage"
            style="@style/apollo_body4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="@dimen/space_2"
            android:textColor="@color/neutral_white" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/space_8"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivCopyUser"
                android:layout_width="@dimen/space_20"
                android:layout_height="@dimen/space_20"
                android:layout_marginEnd="@dimen/space_8"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/chat_copy"
                android:src="@drawable/ic_copypaste"
                app:tint="@color/neutral_white" />

            <ImageView
                android:id="@+id/ivEditUser"
                android:layout_width="@dimen/space_20"
                android:layout_height="@dimen/space_20"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/chat_edit"
                android:src="@drawable/ic_edittext"
                app:tint="@color/neutral_white" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:layout_width="@dimen/space_16"
        android:layout_height="@dimen/space_12"
        android:layout_marginTop="@dimen/space_minus_10"
        android:layout_marginEnd="@dimen/space_minus_6"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_bubble_tail_user"
        app:layout_constraintEnd_toEndOf="@id/llUserBubble"
        app:layout_constraintTop_toBottomOf="@id/llUserBubble" />

</androidx.constraintlayout.widget.ConstraintLayout>
