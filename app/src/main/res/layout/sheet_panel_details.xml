<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_24"
    android:paddingTop="@dimen/space_16"
    android:paddingEnd="@dimen/space_24"
    android:paddingBottom="@dimen/space_32">

    <View
        android:layout_width="@dimen/space_111"
        android:layout_height="@dimen/space_13"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_sheet_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvSheetSerial"
            style="@style/apollo_h5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btnSheetClose"
            android:layout_width="@dimen/space_30"
            android:layout_height="@dimen/space_30"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/panels_sheet_close"
            android:src="@drawable/ic_close_circle" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llSheetRows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/btnSheetReport"
        style="@style/apollo_button_outline"
        android:layout_height="@dimen/space_52"
        android:layout_marginHorizontal="@dimen/space_minus_8"
        android:layout_marginTop="@dimen/space_24"
        android:text="@string/panels_sheet_report"
        android:textColor="@color/neutral_black" />
</LinearLayout>
