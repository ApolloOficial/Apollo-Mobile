<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_calendar_card"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_24"
    android:paddingTop="@dimen/space_24"
    android:paddingEnd="@dimen/space_24"
    android:paddingBottom="@dimen/space_28">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/apollo_h5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Foto de perfil"
            android:textColor="@color/neutral_black" />

        <ImageView
            android:id="@+id/btnPhotoClose"
            android:layout_width="@dimen/space_30"
            android:layout_height="@dimen/space_30"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Fechar"
            android:src="@drawable/ic_close_circle" />
    </LinearLayout>

    <TextView
        style="@style/apollo_body2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:text="Escolha como deseja alterar sua foto."
        android:textColor="@color/neutral_black" />

    <TextView
        android:id="@+id/btnPhotoGallery"
        style="@style/apollo_button_primary"
        android:layout_marginTop="@dimen/space_24"
        android:text="Escolher da galeria" />

    <TextView
        android:id="@+id/btnPhotoCamera"
        style="@style/apollo_button_outline"
        android:layout_marginTop="@dimen/space_12"
        android:text="Tirar foto" />

    <TextView
        android:id="@+id/btnPhotoRemove"
        style="@style/apollo_label3"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_44"
        android:layout_marginTop="@dimen/space_8"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:text="Remover foto atual"
        android:textColor="@color/error_one"
        android:visibility="gone" />
</LinearLayout>
