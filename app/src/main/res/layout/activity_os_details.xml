<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neutral_white">

    <!-- Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/screen_horizontal_padding"
        android:paddingTop="@dimen/header_top_padding"
        android:paddingBottom="@dimen/header_bottom_padding"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivProfile"
            android:layout_width="@dimen/header_control_size"
            android:layout_height="@dimen/header_control_size"
            android:scaleType="centerCrop"
            android:src="@drawable/profile_picture"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

        <TextView
            android:id="@+id/tvLocation"
            style="@style/apollo_label4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/header_item_spacing"
            android:layout_marginEnd="@dimen/header_item_spacing"
            android:background="@drawable/edittext_bg"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="@dimen/space_12"
            android:paddingVertical="@dimen/space_6"
            android:text="Fábrica Itajaí, Limeira - SP"
            android:textColor="@color/neutral_black"
            app:layout_constraintBottom_toBottomOf="@id/ivProfile"
            app:layout_constraintEnd_toStartOf="@id/ibNotifications"
            app:layout_constraintStart_toEndOf="@id/ivProfile"
            app:layout_constraintTop_toTopOf="@id/ivProfile" />

        <ImageButton
            android:id="@+id/ibNotifications"
            android:layout_width="@dimen/header_control_size"
            android:layout_height="@dimen/header_control_size"
            android:background="@drawable/edittext_bg"
            android:src="@drawable/ic_notifications"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/topBar"
        android:name="org.apollo.mobile.view.common.TopBarFragment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_horizontal_padding"
            android:paddingBottom="@dimen/content_bottom_padding">

            <!-- Back Button -->
            <LinearLayout
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:minHeight="@dimen/touch_target_min_size"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/space_16"
                    android:layout_height="@dimen/space_16"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/neutral_black" />

                <TextView
                    style="@style/apollo_label3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8"
                    android:text="@string/service_orders_back"
                    android:textColor="@color/neutral_black" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvOsId"
                style="@style/apollo_h4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:textColor="@color/neutral_black"
                tools:text="OS84525" />

            <!-- Tags: status + prioridade -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvStatusTag"
                    style="@style/apollo_label6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_label_rounded"
                    android:paddingHorizontal="@dimen/space_16"
                    android:paddingVertical="@dimen/space_4"
                    android:textColor="@color/neutral_black"
                    tools:backgroundTint="@color/primary_one"
                    tools:text="Em andamento" />

                <TextView
                    android:id="@+id/tvPriorityTag"
                    style="@style/apollo_label6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8"
                    android:background="@drawable/bg_label_rounded"
                    android:paddingHorizontal="@dimen/space_16"
                    android:paddingVertical="@dimen/space_4"
                    android:textColor="@color/neutral_black"
                    tools:backgroundTint="@color/primary_one"
                    tools:text="Média" />
            </LinearLayout>

            <!-- Linhas de informação (preenchidas no código conforme o tipo da OS) -->
            <LinearLayout
                android:id="@+id/llInfoRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:orientation="vertical" />

            <!-- Descrição -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:background="@drawable/bg_os_card"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

                <TextView
                    style="@style/apollo_label2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/os_details_label_description"
                    android:textColor="@color/neutral_black" />

                <TextView
                    android:id="@+id/tvDescription"
                    style="@style/apollo_body3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:textColor="@color/neutral_black"
                    tools:text="String 1 (lote ITJ-LIM-001) gerando 41% abaixo da etiqueta." />
            </LinearLayout>

            <!-- Placas verificadas (OS de string / inversor em andamento) -->
            <LinearLayout
                android:id="@+id/llVerifiedSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/apollo_h6"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/verified_plates_header_title"
                        android:textColor="@color/neutral_black" />

                    <TextView
                        android:id="@+id/tvVerifiedCount"
                        style="@style/apollo_body4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/neutral_gray"
                        tools:text="0 de 24" />
                </LinearLayout>

                <!-- Um card por string (item_string_group) -->
                <LinearLayout
                    android:id="@+id/llStringGroups"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Histórico de andamento -->
            <TextView
                style="@style/apollo_h5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:text="@string/os_details_progress_title"
                android:textColor="@color/neutral_black" />

            <LinearLayout
                android:id="@+id/llHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:orientation="vertical" />

            <!-- Resumo (OS concluída) -->
            <include
                android:id="@+id/cardSummary"
                layout="@layout/item_os_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:visibility="gone" />

            <!-- Ações -->
            <Button
                android:id="@+id/btnSecondary"
                style="@style/apollo_label2"
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_56"
                android:layout_marginTop="@dimen/space_32"
                android:background="@drawable/btn_outlined"
                android:textAllCaps="false"
                android:textColor="@color/neutral_black"
                android:visibility="gone"
                app:backgroundTint="@null"
                tools:text="Condição registrada!"
                tools:visibility="visible" />

            <Button
                android:id="@+id/btnPrimary"
                style="@style/apollo_label2"
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_56"
                android:layout_marginTop="@dimen/space_16"
                android:backgroundTint="@color/secondary_three"
                android:textAllCaps="false"
                android:textColor="@color/neutral_white"
                android:visibility="gone"
                app:cornerRadius="@dimen/space_28"
                tools:text="Ir para conclusão"
                tools:visibility="visible" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Footer + chatbot compartilhados -->
    <include layout="@layout/layout_bottom_nav" />

</androidx.constraintlayout.widget.ConstraintLayout>
