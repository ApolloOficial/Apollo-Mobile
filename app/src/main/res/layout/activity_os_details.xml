<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neutral_white">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/topBar"
        android:name="org.apollo.mobile.view.common.TopBarFragment"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/content_max_width" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintWidth_max="@dimen/content_max_width">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_horizontal_padding"
            android:paddingTop="@dimen/space_16"
            android:paddingEnd="@dimen/screen_horizontal_padding"
            android:paddingBottom="@dimen/content_bottom_padding">

            <TextView
                android:id="@+id/btnBack"
                style="@style/apollo_back" />

            <org.apollo.mobile.view.common.SkeletonView
        android:id="@+id/progressOsDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_8" />

            <include
                android:id="@+id/osEmptyState"
                layout="@layout/view_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/llOsContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

            <TextView
                android:id="@+id/tvOsId"
                style="@style/apollo_h4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_10"
                android:text="@string/l_5f9048df2f" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvStatusTag"
                    style="@style/apollo_tag"
                    android:backgroundTint="@color/info_two"
                    android:minWidth="@dimen/space_103"
                    android:text="@string/l_05d22f8223" />

                <TextView
                    android:id="@+id/tvPriorityTag"
                    style="@style/apollo_tag"
                    android:layout_marginStart="@dimen/space_4"
                    android:backgroundTint="@color/alert_two"
                    android:minWidth="@dimen/space_80"
                    android:text="@string/l_10cf998631" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llInfoRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:background="@drawable/bg_surface_card"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

                <TextView
                    style="@style/apollo_label2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/l_c1c2501bcc" />

                <TextView
                    android:id="@+id/tvDescription"
                    style="@style/apollo_body3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:lineSpacingExtra="@dimen/space_2"
                    android:text="-" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llVerifiedSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/apollo_h6"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/l_c0f04aa2b4" />

                    <TextView
                        android:id="@+id/tvVerifiedCount"
                        style="@style/apollo_body3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/l_2feebf64d0"
                        android:textColor="@color/neutral_gray" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llStringGroups"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <TextView
                style="@style/apollo_h5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:text="@string/l_42861f453f" />

            <LinearLayout
                android:id="@+id/llHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_20"
                android:orientation="vertical" />

            <include
                android:id="@+id/cardSummary"
                layout="@layout/item_os_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/cardReport"
                style="@style/apollo_info_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/apollo_label3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/l_281fe8098f" />

                <TextView
                    android:id="@+id/tvReport"
                    style="@style/apollo_body4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:textColor="@color/neutral_gray" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnSecondary"
                style="@style/apollo_button_outline"
                android:layout_height="@dimen/space_52"
                android:layout_marginTop="@dimen/space_24"
                android:textColor="@color/neutral_black"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnPrimary"
                style="@style/apollo_button_primary"
                android:layout_height="@dimen/space_52"
                android:layout_marginTop="@dimen/space_12"
                android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include layout="@layout/layout_bottom_nav" />

</androidx.constraintlayout.widget.ConstraintLayout>
