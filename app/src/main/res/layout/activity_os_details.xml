<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neutral_white">

    <!-- Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="32dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivProfile"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:scaleType="centerCrop"
            android:src="@drawable/profile_picture"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

        <TextView
            android:id="@+id/tvLocation"
            style="@style/apollo_label4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/edittext_bg"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="Fábrica Itajaí, Limeira - SP"
            android:textColor="@color/neutral_black"
            app:layout_constraintBottom_toBottomOf="@id/ivProfile"
            app:layout_constraintEnd_toStartOf="@id/ibNotifications"
            app:layout_constraintStart_toEndOf="@id/ivProfile"
            app:layout_constraintTop_toTopOf="@id/ivProfile" />

        <ImageButton
            android:id="@+id/ibNotifications"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/edittext_bg"
            android:src="@drawable/ic_notifications"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintTop_toBottomOf="@id/clHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="120dp">

            <!-- Back Button -->
            <LinearLayout
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/neutral_black" />

                <TextView
                    style="@style/apollo_label3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/service_orders_back"
                    android:textColor="@color/neutral_black" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvOsId"
                style="@style/apollo_h4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="OS84524"
                android:textColor="@color/neutral_black"
                android:textStyle="bold" />

            <!-- Tags -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/apollo_label6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_label_rounded"
                    android:backgroundTint="@color/info_two"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="4dp"
                    android:text="@string/service_orders_tag_open"
                    android:textColor="@color/neutral_black" />

                <TextView
                    style="@style/apollo_label6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_label_rounded"
                    android:backgroundTint="@color/primary_two"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="4dp"
                    android:text="@string/service_orders_tag_medium"
                    android:textColor="@color/neutral_black" />

            </LinearLayout>

            <!-- Details List -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="6dp">
                    <TextView style="@style/apollo_label3" android:text="@string/os_details_label_inverter" android:textColor="@color/neutral_gray" />
                    <TextView style="@style/apollo_label3" android:layout_alignParentRight="true" android:text="Inversor 01 / ITJ-LIM-001" android:textColor="@color/neutral_black" />
                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="6dp">
                    <TextView style="@style/apollo_label3" android:text="@string/os_details_label_position" android:textColor="@color/neutral_gray" />
                    <TextView style="@style/apollo_label3" android:layout_alignParentRight="true" android:text="14" android:textColor="@color/neutral_black" />
                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="6dp">
                    <TextView style="@style/apollo_label3" android:text="@string/os_details_label_serial" android:textColor="@color/neutral_gray" />
                    <TextView style="@style/apollo_label3" android:layout_alignParentRight="true" android:text="CS-2024-00765" android:textColor="@color/neutral_black" />
                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="6dp">
                    <TextView style="@style/apollo_label3" android:text="@string/os_details_label_type" android:textColor="@color/neutral_gray" />
                    <TextView style="@style/apollo_label3" android:layout_alignParentRight="true" android:text="Corretiva" android:textColor="@color/neutral_black" />
                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="6dp">
                    <TextView style="@style/apollo_label3" android:text="@string/os_details_label_deadline" android:textColor="@color/neutral_gray" />
                    <TextView style="@style/apollo_label3" android:layout_alignParentRight="true" android:text="30/09/2026" android:textColor="@color/neutral_black" />
                </RelativeLayout>

            </LinearLayout>

            <!-- Description Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/neutral_white"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView style="@style/apollo_label2" android:text="@string/os_details_label_description" android:textColor="@color/neutral_black" />
                    <TextView style="@style/apollo_body3" android:layout_marginTop="4dp" android:text="A placa soltou a moldura." android:textColor="@color/neutral_gray" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- History Title -->
            <TextView
                style="@style/apollo_h5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/os_details_progress_title"
                android:textColor="@color/neutral_black"
                android:textStyle="bold" />

            <!-- Timeline -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <!-- Line -->
                <View
                    android:id="@+id/vLine"
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="5dp"
                    android:background="#D1D1D1"
                    app:layout_constraintBottom_toBottomOf="@id/ivDot2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/ivDot1" />

                <!-- Item 1 -->
                <ImageView
                    android:id="@+id/ivDot1"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@drawable/bg_status_dot"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/sucess_one" />

                <TextView
                    android:id="@+id/tvHistoryTitle1"
                    style="@style/apollo_label3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/os_details_history_created"
                    android:textColor="@color/neutral_black"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/ivDot1"
                    app:layout_constraintTop_toTopOf="@id/ivDot1"
                    app:layout_constraintBottom_toBottomOf="@id/ivDot1"/>

                <TextView
                    android:id="@+id/tvHistoryDesc1"
                    style="@style/apollo_body4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/os_details_history_created_desc"
                    android:textColor="@color/neutral_gray"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/tvHistoryTitle1"
                    app:layout_constraintTop_toBottomOf="@id/tvHistoryTitle1" />

                <!-- Item 2 -->
                <ImageView
                    android:id="@+id/ivDot2"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginTop="24dp"
                    android:src="@drawable/bg_status_dot"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvHistoryDesc1"
                    app:tint="@color/alert_one" />

                <TextView
                    android:id="@+id/tvHistoryTitle2"
                    style="@style/apollo_label3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/os_details_history_waiting"
                    android:textColor="@color/neutral_black"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/ivDot2"
                    app:layout_constraintTop_toTopOf="@id/ivDot2"
                    app:layout_constraintBottom_toBottomOf="@id/ivDot2" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Action Button -->
            <Button
                android:id="@+id/btnScan"
                style="@style/apollo_label2"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:backgroundTint="@color/secondary_three"
                android:text="@string/os_details_btn_scan"
                android:textAllCaps="false"
                android:textColor="@color/neutral_white"
                app:cornerRadius="28dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Footer + chatbot compartilhados -->
    <include layout="@layout/layout_bottom_nav" />

</androidx.constraintlayout.widget.ConstraintLayout>
