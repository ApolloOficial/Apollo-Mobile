<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_8"
    android:background="@drawable/bg_surface_card"
    android:foreground="@drawable/ripple_card"
    android:paddingStart="@dimen/space_16"
    android:paddingTop="@dimen/space_16"
    android:paddingEnd="@dimen/space_18"
    android:paddingBottom="@dimen/space_16">

    <TextView
        android:id="@+id/tvSubtitle"
        style="@style/apollo_label2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Placa CS-2024-00765"
        android:textColor="@color/neutral_gray"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvMainId"
        style="@style/apollo_h5"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="OS84524"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle" />

    <LinearLayout
        android:id="@+id/llTags"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvMainId">

        <TextView
            android:id="@+id/tvStatusTag"
            style="@style/apollo_tag"
            android:backgroundTint="@color/info_two"
            android:minWidth="@dimen/space_103"
            android:text="Aberta" />

        <TextView
            android:id="@+id/tvPriorityTag"
            style="@style/apollo_tag"
            android:layout_marginStart="@dimen/space_4"
            android:backgroundTint="@color/alert_two"
            android:minWidth="@dimen/space_80"
            android:text="Média" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnDetails"
        style="@style/apollo_cta_outline"
        android:layout_marginTop="@dimen/space_8"
        android:text="Ver detalhes"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llTags" />

    <TextView
        android:id="@+id/tvDueDate"
        style="@style/apollo_body4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_1"
        android:layout_marginEnd="@dimen/space_8"
        android:text="Prazo: 30/09/2026"
        android:textColor="@color/neutral_gray"
        app:layout_constraintBottom_toBottomOf="@id/btnDetails"
        app:layout_constraintEnd_toStartOf="@id/btnDetails"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnDetails" />

</androidx.constraintlayout.widget.ConstraintLayout>
