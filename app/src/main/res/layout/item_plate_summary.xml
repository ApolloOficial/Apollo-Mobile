<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="@dimen/space_4"
    android:paddingBottom="@dimen/space_4">

    <View
        android:id="@+id/vStatusDot"
        android:layout_width="@dimen/space_5"
        android:layout_height="@dimen/space_5"
        android:background="@drawable/bg_dot_active"
        android:backgroundTint="@color/sucess_one" />

    <TextView
        android:id="@+id/tvPlateName"
        style="@style/apollo_body4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_5"
        android:layout_weight="1"
        android:text="@string/l_cd83fbaec6" />

    <TextView
        android:id="@+id/tvPlateValue"
        style="@style/apollo_body4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="87%" />

</LinearLayout>
