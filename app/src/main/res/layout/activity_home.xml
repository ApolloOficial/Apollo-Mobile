<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neutral_white">

    <!-- Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/screen_horizontal_padding"
        android:paddingTop="@dimen/header_top_padding"
        android:paddingBottom="@dimen/header_bottom_padding"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivProfile"
            android:layout_width="@dimen/header_control_size"
            android:layout_height="@dimen/header_control_size"
            android:scaleType="centerCrop"
            android:src="@drawable/profile_picture"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

        <TextView
            android:id="@+id/tvLocation"
            style="@style/apollo_label4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/header_item_spacing"
            android:layout_marginEnd="@dimen/header_item_spacing"
            android:background="@drawable/edittext_bg"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="@dimen/space_16"
            android:paddingVertical="@dimen/space_8"
            android:text="Fábrica Itajaí, Limeira - SP"
            android:textColor="@color/neutral_black"
            app:layout_constraintBottom_toBottomOf="@id/ivProfile"
            app:layout_constraintEnd_toStartOf="@id/ibNotifications"
            app:layout_constraintStart_toEndOf="@id/ivProfile"
            app:layout_constraintTop_toTopOf="@id/ivProfile" />

        <ImageButton
            android:id="@+id/ibNotifications"
            android:layout_width="@dimen/header_control_size"
            android:layout_height="@dimen/header_control_size"
            android:background="@drawable/edittext_bg"
            android:src="@drawable/ic_notifications"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/topBar"
        android:name="org.apollo.mobile.view.common.TopBarFragment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_horizontal_padding"
            android:paddingBottom="@dimen/content_bottom_padding">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16">

                <TextView
                    android:id="@+id/tvGreeting"
                    style="@style/apollo_h4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bom dia, Carlos"
                    android:textColor="@color/neutral_black"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvSubGreeting"
                    style="@style/apollo_body3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vamos manter tudo funcionando"
                    android:textColor="@color/neutral_gray"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvGreeting" />

                <ImageView
                    android:id="@+id/ivSync"
                    android:layout_width="@dimen/space_32"
                    android:layout_height="@dimen/space_32"
                    android:contentDescription="@string/home_sync_content_description"
                    android:src="@drawable/ic_sync"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/neutral_gray" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Seção Suas OS -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_32">

                <TextView
                    style="@style/apollo_label1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Suas OS"
                    android:textColor="@color/neutral_black"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvServiceOrderCount"
                    style="@style/apollo_label3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ver todas (3)"
                    android:textColor="@color/secondary_three"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardServiceOrder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                app:cardBackgroundColor="@color/neutral_white"
                app:cardCornerRadius="@dimen/space_24"
                app:cardElevation="2dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="@dimen/space_12">

                    <LinearLayout
                        android:id="@+id/llTags"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_16"
                        android:layout_marginTop="@dimen/space_8"
                        android:orientation="horizontal"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvPlacaValue">

                        <TextView
                            android:id="@+id/tvStatusTag"
                            style="@style/apollo_label6"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_label_rounded"
                            android:backgroundTint="@color/alert_two"
                            android:includeFontPadding="false"
                            android:paddingHorizontal="@dimen/space_12"
                            android:paddingVertical="@dimen/space_4"
                            android:text="Em andamento"
                            android:textColor="@color/neutral_black"
                            android:textSize="@dimen/text_12" />

                        <TextView
                            android:id="@+id/tvPriorityTag"
                            style="@style/apollo_label6"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_4"
                            android:background="@drawable/bg_label_rounded"
                            android:backgroundTint="@color/error_two"
                            android:includeFontPadding="false"
                            android:paddingHorizontal="@dimen/space_12"
                            android:paddingVertical="@dimen/space_4"
                            android:text="Alta"
                            android:textColor="@color/neutral_black"
                            android:textSize="@dimen/text_12" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvPlacaLabel"
                        style="@style/apollo_label2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_16"
                        android:layout_marginTop="@dimen/space_12"
                        android:includeFontPadding="false"
                        android:text="Placa CS-2023-00529"
                        android:textColor="@color/neutral_gray"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvPlacaValue"
                        style="@style/apollo_h5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_16"
                        android:includeFontPadding="false"
                        android:text="OS84524"
                        android:textColor="@color/neutral_black"
                        android:textSize="@dimen/text_26"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvPlacaLabel" />

                    <TextView
                        android:id="@+id/tvOsId"
                        style="@style/apollo_body3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_16"
                        android:includeFontPadding="false"
                        android:text="ID: OS84424"
                        android:textColor="@color/neutral_gray"
                        android:visibility="gone"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvPlacaValue" />

                    <TextView
                        android:id="@+id/tvOsPrazo"
                        style="@style/apollo_body3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_16"
                        android:includeFontPadding="false"
                        android:text="Prazo: 03/10/2026"
                        android:textColor="@color/neutral_gray"
                        app:layout_constraintBottom_toBottomOf="@id/btnOsDetails"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@id/btnOsDetails" />

                    <Button
                        android:id="@+id/btnOsDetails"
                        style="@style/apollo_label2"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/touch_target_min_size"
                        android:layout_marginTop="@dimen/space_8"
                        android:layout_marginEnd="@dimen/space_16"
                        android:background="@drawable/btn_outlined"
                        android:gravity="center"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingHorizontal="@dimen/space_16"
                        android:text="Ver detalhes"
                        android:textAllCaps="false"
                        android:textColor="@color/secondary_three"
                        android:textSize="@dimen/text_14"
                        app:backgroundTint="@null"
                        app:cornerRadius="@dimen/space_24"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/llTags" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tvServiceOrderEmpty"
                style="@style/apollo_body2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:gravity="center"
                android:text="@string/home_empty_service_orders"
                android:textColor="@color/neutral_gray"
                android:visibility="gone" />

            <!-- Paginação Suas OS -->
            <LinearLayout
                android:id="@+id/llOsPagination"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/space_20"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnPrevOs"
                    android:layout_width="@dimen/space_48"
                    android:layout_height="@dimen/space_48"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Página anterior"
                    android:padding="@dimen/space_8"
                    android:rotation="180"
                    android:scaleType="fitCenter"
                    android:src="@drawable/lucide_circle_chevron_right"
                    app:tint="@color/pagination_arrow_tint" />

                <LinearLayout
                    android:id="@+id/llOsIndicators"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal" />

                <ImageButton
                    android:id="@+id/btnNextOs"
                    android:layout_width="@dimen/space_48"
                    android:layout_height="@dimen/space_48"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Próxima página"
                    android:padding="@dimen/space_8"
                    android:scaleType="fitCenter"
                    android:src="@drawable/lucide_circle_chevron_right"
                    app:tint="@color/pagination_arrow_tint" />

            </LinearLayout>

            <!-- Seção Requer Atenção -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24">

                <TextView
                    style="@style/apollo_label1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Requer atenção"
                    android:textColor="@color/neutral_black"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvAttentionCount"
                    style="@style/apollo_label3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ver todas (2)"
                    android:textColor="@color/secondary_three"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardAttention"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                app:cardBackgroundColor="@color/neutral_white"
                app:cardCornerRadius="@dimen/space_16"
                app:cardElevation="2dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/space_16">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cvAlertIcon"
                        android:layout_width="@dimen/space_64"
                        android:layout_height="@dimen/space_64"
                        app:cardBackgroundColor="#FFEBEB"
                        app:cardCornerRadius="@dimen/space_12"
                        app:cardElevation="0dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:layout_width="@dimen/space_32"
                            android:layout_height="@dimen/space_32"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_warning"
                            app:tint="@color/error_one" />

                    </androidx.cardview.widget.CardView>

                    <TextView
                        android:id="@+id/tvCriticoTag"
                        style="@style/apollo_label6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_16"
                        android:background="@drawable/bg_label_rounded"
                        android:backgroundTint="@color/error_one"
                        android:paddingHorizontal="@dimen/space_12"
                        android:paddingVertical="@dimen/space_4"
                        android:text="Crítico"
                        android:textColor="@color/neutral_white"
                        app:layout_constraintStart_toEndOf="@id/cvAlertIcon"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvAlertTitle"
                        style="@style/apollo_label2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_16"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="Placa CS-2023-00456 - eficiência crítica"
                        android:textColor="@color/neutral_black"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/cvAlertIcon"
                        app:layout_constraintTop_toBottomOf="@id/tvCriticoTag" />

                    <TextView
                        android:id="@+id/tvAlertEficLabel"
                        style="@style/apollo_body4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:text="Eficiência"
                        android:textColor="@color/neutral_gray"
                        app:layout_constraintStart_toStartOf="@id/tvAlertTitle"
                        app:layout_constraintTop_toBottomOf="@id/tvAlertTitle" />

                    <TextView
                        android:id="@+id/tvAlertPercentage"
                        style="@style/apollo_label4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="42%"
                        android:textColor="@color/error_one"
                        app:layout_constraintBottom_toBottomOf="@id/tvAlertEficLabel"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressAlert"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:progress="42"
                        app:indicatorColor="@color/error_one"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="@id/tvAlertEficLabel"
                        app:layout_constraintTop_toBottomOf="@id/tvAlertEficLabel"
                        app:trackColor="@color/disable_gray"
                        app:trackCornerRadius="@dimen/space_4"
                        app:trackThickness="@dimen/space_8" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tvAttentionEmpty"
                style="@style/apollo_body2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:gravity="center"
                android:text="@string/home_empty_attention"
                android:textColor="@color/neutral_gray"
                android:visibility="gone" />

            <!-- Seção Registros Pendentes -->
            <TextView
                style="@style/apollo_label1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:text="Registros pendentes"
                android:textColor="@color/neutral_black"
                android:textStyle="bold" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cardPending"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                app:cardBackgroundColor="@color/neutral_white"
                app:cardCornerRadius="@dimen/space_16"
                app:cardElevation="2dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/space_16">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cvPendingIcon"
                        android:layout_width="@dimen/space_64"
                        android:layout_height="@dimen/space_64"
                        app:cardBackgroundColor="#E3F2FD"
                        app:cardCornerRadius="@dimen/space_12"
                        app:cardElevation="0dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:layout_width="@dimen/space_32"
                            android:layout_height="@dimen/space_32"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_clipboard"
                            app:tint="@color/info_one" />

                    </androidx.cardview.widget.CardView>

                    <TextView
                        android:id="@+id/tvPendingLote"
                        style="@style/apollo_body4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_16"
                        android:text="Lote ITJ-LIM-02"
                        android:textColor="@color/neutral_gray"
                        app:layout_constraintStart_toEndOf="@id/cvPendingIcon"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvPendingTitle"
                        style="@style/apollo_label2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_16"
                        android:layout_marginTop="2dp"
                        android:text="Faltam 8 placas para registrar"
                        android:textColor="@color/neutral_black"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/cvPendingIcon"
                        app:layout_constraintTop_toBottomOf="@id/tvPendingLote" />

                    <TextView
                        android:id="@+id/tvPendingRegLabel"
                        style="@style/apollo_body4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:text="Registros"
                        android:textColor="@color/neutral_gray"
                        app:layout_constraintStart_toStartOf="@id/tvPendingTitle"
                        app:layout_constraintTop_toBottomOf="@id/tvPendingTitle" />

                    <TextView
                        android:id="@+id/tvPendingCount"
                        style="@style/apollo_label4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="16/24"
                        android:textColor="@color/info_one"
                        app:layout_constraintBottom_toBottomOf="@id/tvPendingRegLabel"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressPending"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:progress="66"
                        app:indicatorColor="@color/info_one"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="@id/tvPendingRegLabel"
                        app:layout_constraintTop_toBottomOf="@id/tvPendingRegLabel"
                        app:trackColor="@color/disable_gray"
                        app:trackCornerRadius="@dimen/space_4"
                        app:trackThickness="@dimen/space_8" />

                    <Button
                        android:id="@+id/btnPendingDetails"
                        style="@style/apollo_label3"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/touch_target_min_size"
                        android:layout_marginTop="@dimen/space_16"
                        android:background="@drawable/btn_outlined"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Ver detalhes"
                        android:textAllCaps="false"
                        android:textColor="@color/secondary_one"
                        app:backgroundTint="@null"
                        app:cornerRadius="@dimen/space_24"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/progressPending" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tvPendingEmpty"
                style="@style/apollo_body2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:gravity="center"
                android:text="@string/home_empty_pending"
                android:textColor="@color/neutral_gray"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Footer + chatbot compartilhados -->
    <include layout="@layout/layout_bottom_nav" />

</androidx.constraintlayout.widget.ConstraintLayout>
