<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neutral_white">

    <!-- Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingTop="48dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivProfile"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerCrop"
            android:src="@drawable/profile_picture"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

        <TextView
            android:id="@+id/tvLocation"
            style="@style/apollo_label4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/edittext_bg"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="Fábrica Itajaí, Limeira - SP"
            android:textColor="@color/neutral_black"
            app:layout_constraintBottom_toBottomOf="@id/ivProfile"
            app:layout_constraintEnd_toStartOf="@id/ibNotifications"
            app:layout_constraintStart_toEndOf="@id/ivProfile"
            app:layout_constraintTop_toTopOf="@id/ivProfile" />

        <ImageButton
            android:id="@+id/ibNotifications"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/edittext_bg"
            android:src="@drawable/ic_notifications"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintTop_toBottomOf="@id/clHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="120dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <TextView
                    android:id="@+id/tvGreeting"
                    style="@style/apollo_h4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bom dia, Carlos"
                    android:textColor="@color/neutral_black"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvSubGreeting"
                    style="@style/apollo_body3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vamos manter tudo funcionando"
                    android:textColor="@color/neutral_gray"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvGreeting" />

                <ImageView
                    android:id="@+id/ivSync"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_sync"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/neutral_gray" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Seção Suas OS -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp">

                <TextView
                    style="@style/apollo_label1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Suas OS"
                    android:textColor="@color/neutral_black"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    style="@style/apollo_label3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ver todas (3)"
                    android:textColor="@color/secondary_three"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/neutral_white"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <LinearLayout
                        android:id="@+id/llTags"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:id="@+id/tvStatusTag"
                            style="@style/apollo_label6"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:background="@drawable/btn_primary"
                            android:backgroundTint="@color/alert_one"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="4dp"
                            android:text="Em andamento"
                            android:textColor="@color/neutral_white"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvPriorityTag"
                            style="@style/apollo_label6"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:background="@drawable/btn_primary"
                            android:backgroundTint="@color/error_two"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="4dp"
                            android:text="Alta"
                            android:textColor="@color/neutral_white"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvPlacaLabel"
                        style="@style/apollo_body2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Placa"
                        android:textColor="@color/neutral_gray"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvPlacaValue"
                        style="@style/apollo_h5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CS-2023-00529"
                        android:textColor="@color/neutral_black"
                        android:textStyle="bold"
                        android:textSize="26sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvPlacaLabel" />

                    <TextView
                        android:id="@+id/tvOsId"
                        style="@style/apollo_body3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ID: OS84424"
                        android:textColor="@color/neutral_gray"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvPlacaValue" />

                    <TextView
                        android:id="@+id/tvOsPrazo"
                        style="@style/apollo_body3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Prazo: 03/10/2026"
                        android:textColor="@color/neutral_gray"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvOsId" />

                    <Button
                        android:id="@+id/btnOsDetails"
                        style="@style/apollo_label2"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:background="@drawable/btn_outlined"
                        android:gravity="center"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingHorizontal="24dp"
                        android:text="Ver detalhes"
                        android:textAllCaps="false"
                        android:textColor="@color/secondary_three"
                        android:textSize="14sp"
                        app:backgroundTint="@null"
                        app:cornerRadius="18dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/llTags"
                        app:layout_constraintVertical_bias="1.0" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <!-- Paginação Suas OS -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnPrevOs"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_arrow_gray" />

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginHorizontal="6dp"
                    android:background="@drawable/dot_indicator_active" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginHorizontal="6dp"
                    android:background="@drawable/dot_indicator" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginHorizontal="6dp"
                    android:background="@drawable/dot_indicator" />

                <ImageButton
                    android:id="@+id/btnNextOs"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_arrow_orange" />
            </LinearLayout>

            <!-- Seção Requer Atenção -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp">

                <TextView
                    style="@style/apollo_label1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Requer atenção"
                    android:textColor="@color/neutral_black"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    style="@style/apollo_label3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ver todas (2)"
                    android:textColor="@color/secondary_three"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/neutral_white"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cvAlertIcon"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        app:cardBackgroundColor="#FFEBEB"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_warning"
                            app:tint="@color/error_one" />
                    </androidx.cardview.widget.CardView>

                    <TextView
                        android:id="@+id/tvCriticoTag"
                        style="@style/apollo_label6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:background="@drawable/btn_primary"
                        android:backgroundTint="@color/error_one"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="Crítico"
                        android:textColor="@color/neutral_white"
                        app:layout_constraintStart_toEndOf="@id/cvAlertIcon"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvAlertTitle"
                        style="@style/apollo_label2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="4dp"
                        android:text="Placa CS-2023-00456 - eficiência crítica"
                        android:textColor="@color/neutral_black"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/cvAlertIcon"
                        app:layout_constraintTop_toBottomOf="@id/tvCriticoTag" />

                    <TextView
                        android:id="@+id/tvAlertEficLabel"
                        style="@style/apollo_body4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Eficiência"
                        android:textColor="@color/neutral_gray"
                        app:layout_constraintStart_toStartOf="@id/tvAlertTitle"
                        app:layout_constraintTop_toBottomOf="@id/tvAlertTitle" />

                    <TextView
                        style="@style/apollo_label4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="42%"
                        android:textColor="@color/error_one"
                        app:layout_constraintBottom_toBottomOf="@id/tvAlertEficLabel"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:progress="42"
                        app:indicatorColor="@color/error_one"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="@id/tvAlertEficLabel"
                        app:layout_constraintTop_toBottomOf="@id/tvAlertEficLabel"
                        app:trackColor="@color/disable_gray"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="8dp" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <!-- Seção Registros Pendentes -->
            <TextView
                style="@style/apollo_label1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Registros pendentes"
                android:textColor="@color/neutral_black"
                android:textStyle="bold" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/neutral_white"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cvPendingIcon"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        app:cardBackgroundColor="#E3F2FD"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_clipboard"
                            app:tint="@color/info_one" />
                    </androidx.cardview.widget.CardView>

                    <TextView
                        android:id="@+id/tvPendingLote"
                        style="@style/apollo_body4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="Lote ITJ-LIM-02"
                        android:textColor="@color/neutral_gray"
                        app:layout_constraintStart_toEndOf="@id/cvPendingIcon"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvPendingTitle"
                        style="@style/apollo_label2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="2dp"
                        android:text="Faltam 8 placas para registrar"
                        android:textColor="@color/neutral_black"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/cvPendingIcon"
                        app:layout_constraintTop_toBottomOf="@id/tvPendingLote" />

                    <TextView
                        android:id="@+id/tvPendingRegLabel"
                        style="@style/apollo_body4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Registros"
                        android:textColor="@color/neutral_gray"
                        app:layout_constraintStart_toStartOf="@id/tvPendingTitle"
                        app:layout_constraintTop_toBottomOf="@id/tvPendingTitle" />

                    <TextView
                        style="@style/apollo_label4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="16/24"
                        android:textColor="@color/info_one"
                        app:layout_constraintBottom_toBottomOf="@id/tvPendingRegLabel"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressPending"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:progress="66"
                        app:indicatorColor="@color/info_one"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="@id/tvPendingRegLabel"
                        app:layout_constraintTop_toBottomOf="@id/tvPendingRegLabel"
                        app:trackColor="@color/disable_gray"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="8dp" />

                    <Button
                        android:id="@+id/btnPendingDetails"
                        style="@style/apollo_label3"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/btn_outlined"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Ver detalhes"
                        android:textAllCaps="false"
                        android:textColor="@color/secondary_one"
                        app:backgroundTint="@null"
                        app:cornerRadius="20dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/progressPending" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Botão Chatbot Circular -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabChatbot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="32dp"
        android:src="@drawable/ic_chatbot"
        app:backgroundTint="@color/secondary_three"
        app:fabSize="normal"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/neutral_white" />

    <!-- Navigation Footer -->
    <androidx.cardview.widget.CardView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="40dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="16dp">

            <LinearLayout
                android:id="@+id/llHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/ivPanels"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_home_black" />

                <View
                    android:layout_width="28dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_indicator_home" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivPanels"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_solarpanel_gray"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/cvScanContainer"
                app:layout_constraintStart_toEndOf="@id/llHome"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cvScanContainer"
                android:layout_width="64dp"
                android:layout_height="64dp"
                app:cardBackgroundColor="@color/secondary_three"
                app:cardCornerRadius="32dp"
                app:cardElevation="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/ivTools"
                app:layout_constraintStart_toEndOf="@id/ivPanels"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_scan"
                    app:tint="@color/neutral_white" />
            </androidx.cardview.widget.CardView>

            <ImageView
                android:id="@+id/ivTools"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_tools_gray"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/ivSettings"
                app:layout_constraintStart_toEndOf="@id/cvScanContainer"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/ivSettings"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_settings_gray"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/ivTools"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>