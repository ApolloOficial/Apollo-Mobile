<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_24"
    android:paddingTop="@dimen/space_16"
    android:paddingEnd="@dimen/space_24"
    android:paddingBottom="@dimen/space_32">

    <View
        android:layout_width="@dimen/space_111"
        android:layout_height="@dimen/space_13"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_sheet_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/apollo_h5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/l_fa7e5a081b"
            android:textColor="@color/neutral_black" />

        <ImageView
            android:id="@+id/btnSheetClose"
            android:layout_width="@dimen/space_30"
            android:layout_height="@dimen/space_30"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/l_23781b5ede"
            android:src="@drawable/ic_close_circle" />
    </LinearLayout>

    <TextView
        style="@style/apollo_label3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_20"
        android:text="@string/l_3642384da1"
        android:textColor="@color/neutral_black" />

    <EditText
        android:id="@+id/etCurrentPassword"
        style="@style/apollo_label3"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_48"
        android:layout_marginTop="@dimen/space_8"
        android:background="@drawable/edittext_bg"
        android:hint="@string/l_e558e075e9"
        android:importantForAutofill="no"
        android:inputType="textPassword"
        android:maxLines="1"
        android:paddingHorizontal="@dimen/space_16"
        android:textColorHint="@color/disable_gray" />

    <TextView
        style="@style/apollo_label3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_20"
        android:text="@string/l_8e44dcdc80"
        android:textColor="@color/neutral_black" />

    <EditText
        android:id="@+id/etNewPassword"
        style="@style/apollo_label3"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_48"
        android:layout_marginTop="@dimen/space_8"
        android:background="@drawable/edittext_bg"
        android:drawableStart="@drawable/ic_lock"
        android:drawableEnd="@drawable/ic_eye"
        android:drawablePadding="@dimen/space_12"
        android:hint="@string/l_774199645e"
        android:importantForAutofill="no"
        android:inputType="textPassword"
        android:maxLines="1"
        android:paddingHorizontal="@dimen/space_16"
        android:textColorHint="@color/disable_gray" />

    <TextView
        style="@style/apollo_label3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_20"
        android:text="@string/l_f01ca6de96"
        android:textColor="@color/neutral_black" />

    <EditText
        android:id="@+id/etConfirmPassword"
        style="@style/apollo_label3"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_48"
        android:layout_marginTop="@dimen/space_8"
        android:background="@drawable/edittext_bg"
        android:drawableStart="@drawable/ic_lock"
        android:drawableEnd="@drawable/ic_eye"
        android:drawablePadding="@dimen/space_12"
        android:hint="@string/l_774199645e"
        android:importantForAutofill="no"
        android:inputType="textPassword"
        android:maxLines="1"
        android:paddingHorizontal="@dimen/space_16"
        android:textColorHint="@color/disable_gray" />

    <TextView
        android:id="@+id/tvPasswordRules"
        style="@style/apollo_body4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_8"
        android:layout_marginTop="@dimen/space_12"
        android:fontFamily="@font/manrope_bold"
        android:lineSpacingExtra="@dimen/space_4"
        android:text="@string/l_66bfb9aa61"
        android:textColor="@color/neutral_gray" />

    <TextView
        android:id="@+id/btnChangePassword"
        style="@style/apollo_button_primary"
        android:layout_marginHorizontal="@dimen/space_minus_8"
        android:layout_marginTop="@dimen/space_24"
        android:text="@string/l_fa7e5a081b" />
</LinearLayout>
