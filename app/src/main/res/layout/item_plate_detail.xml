<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardPlate"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_8"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/surface_white"
    app:cardCornerRadius="@dimen/space_16"
    app:cardElevation="0dp"
    app:rippleColor="@color/ripple_orange"
    app:strokeColor="@color/disable_gray"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/space_24"
        android:paddingTop="@dimen/space_16"
        android:paddingEnd="@dimen/space_16"
        android:paddingBottom="@dimen/space_16">

        <TextView
            android:id="@+id/tvSerialNumberLabel"
            style="@style/apollo_label3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/l_122342a3ff"
            android:textColor="@color/neutral_gray"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvSerialNumber"
            style="@style/apollo_h6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:layout_marginEnd="@dimen/space_8"
            android:text="@string/l_cd83fbaec6"
            app:layout_constraintEnd_toStartOf="@id/llStatusTag"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSerialNumberLabel" />

        <TextView
            android:id="@+id/tvPosition"
            style="@style/apollo_label4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:text="@string/l_9d20949e04"
            android:textColor="@color/neutral_gray"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSerialNumber" />

        <LinearLayout
            android:id="@+id/llStatusTag"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/space_20"
            android:background="@drawable/bg_tag"
            android:backgroundTint="@color/sucess_two"
            android:gravity="center"
            android:minWidth="@dimen/space_80"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_8"
            android:paddingEnd="@dimen/space_8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvStatusTagText"
                style="@style/apollo_label5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/l_efa2e9d7d0" />

            <ImageView
                android:id="@+id/ivStatusIcon"
                android:layout_width="@dimen/space_12"
                android:layout_height="@dimen/space_12"
                android:layout_marginStart="@dimen/space_4"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_warning_small"
                android:visibility="gone" />
        </LinearLayout>

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrierHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="tvSerialNumber,tvPosition" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clEfficiency"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_14"
            android:layout_marginEnd="@dimen/space_8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/barrierHeader">

            <TextView
                android:id="@+id/tvEfficiencyLabel"
                style="@style/apollo_label5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/l_e187ef2a31"
                android:textColor="@color/neutral_gray"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvEfficiencyValue"
                style="@style/apollo_label5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="87%"
                android:textColor="@color/sucess_one"
                app:layout_constraintBottom_toBottomOf="@id/tvEfficiencyLabel"
                app:layout_constraintEnd_toEndOf="parent" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressEfficiency"
                style="@style/apollo_progress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:progress="87"
                app:indicatorColor="@color/sucess_two"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvEfficiencyLabel" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/tvStockInfo"
            style="@style/apollo_label2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_15"
            android:text="@string/l_3463c49e25"
            android:textColor="@color/neutral_gray"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/barrierHeader" />

        <TextView
            android:id="@+id/btnVerOS"
            style="@style/apollo_cta_outline"
            android:layout_marginTop="@dimen/space_16"
            android:layout_marginEnd="@dimen/space_8"
            android:text="@string/l_892e7513e4"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/clEfficiency" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
