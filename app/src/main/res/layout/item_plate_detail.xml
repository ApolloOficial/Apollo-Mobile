<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardPlate"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_12"
    app:cardBackgroundColor="@color/neutral_white"
    app:cardCornerRadius="@dimen/space_16"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="@android:color/transparent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/space_16">

        <TextView
            android:id="@+id/tvSerialNumberLabel"
            style="@style/apollo_body4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Número de série"
            android:textColor="@color/neutral_gray"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvSerialNumber"
            style="@style/apollo_h6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CS-2025-00841"
            android:textColor="@color/neutral_black"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSerialNumberLabel" />

        <TextView
            android:id="@+id/tvPosition"
            style="@style/apollo_body4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Posição 1"
            android:textColor="@color/neutral_gray"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSerialNumber" />

        <!-- Status Tag -->
        <LinearLayout
            android:id="@+id/llStatusTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_label_rounded"
            android:backgroundTint="@color/sucess_two"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/space_12"
            android:paddingVertical="@dimen/space_4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivStatusIcon"
                android:layout_width="@dimen/space_10"
                android:layout_height="@dimen/space_10"
                android:layout_marginEnd="@dimen/space_4"
                android:src="@drawable/ic_warning"
                android:visibility="gone"
                app:tint="@color/neutral_white" />

            <TextView
                android:id="@+id/tvStatusTagText"
                style="@style/apollo_label6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Em operação"
                android:textColor="@color/neutral_black"
                android:textSize="@dimen/text_12" />

        </LinearLayout>

        <!-- Efficiency Section -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clEfficiency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            app:layout_constraintTop_toBottomOf="@id/tvPosition">

            <TextView
                android:id="@+id/tvEfficiencyLabel"
                style="@style/apollo_body4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Eficiência"
                android:textColor="@color/neutral_gray"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvEfficiencyValue"
                style="@style/apollo_label4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="87%"
                android:textColor="@color/sucess_one"
                app:layout_constraintBottom_toBottomOf="@id/tvEfficiencyLabel"
                app:layout_constraintEnd_toEndOf="parent" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressEfficiency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:progress="87"
                app:indicatorColor="@color/sucess_one"
                app:layout_constraintTop_toBottomOf="@id/tvEfficiencyLabel"
                app:trackColor="@color/disable_gray"
                app:trackCornerRadius="@dimen/space_4"
                app:trackThickness="@dimen/space_8" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Stock Info -->
        <TextView
            android:id="@+id/tvStockInfo"
            style="@style/apollo_body3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:text="Aguardando ativação em campo..."
            android:textColor="@color/neutral_gray"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/tvPosition" />

        <!-- Ver OS Button -->
        <Button
            android:id="@+id/btnVerOS"
            style="@style/apollo_label3"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/space_36"
            android:layout_marginTop="@dimen/space_16"
            android:background="@drawable/btn_outlined"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Ver OS"
            android:textAllCaps="false"
            android:textColor="@color/secondary_three"
            android:visibility="gone"
            app:backgroundTint="@null"
            app:cornerRadius="@dimen/space_18"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/clEfficiency" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
