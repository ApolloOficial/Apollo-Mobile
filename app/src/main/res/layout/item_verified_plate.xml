<?xml version="1.0" encoding="utf-8"?>
<!-- Placa dentro de uma string: número (pendente), ✓ (ok) ou ! (com problema) -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:minHeight="@dimen/space_48"
    android:paddingVertical="@dimen/space_12">

    <TextView
        android:id="@+id/tvNumber"
        style="@style/apollo_label4"
        android:layout_width="@dimen/space_24"
        android:layout_height="@dimen/space_24"
        android:background="@drawable/bg_number_circle"
        android:gravity="center"
        android:textColor="@color/neutral_black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="1" />

    <TextView
        android:id="@+id/tvPlateSerial"
        style="@style/apollo_body2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_12"
        android:textColor="@color/neutral_black"
        app:layout_constraintBottom_toBottomOf="@id/tvNumber"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/tvNumber"
        app:layout_constraintTop_toTopOf="@id/tvNumber"
        tools:text="CS-2025-00900" />

    <View
        android:id="@+id/vDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/space_10"
        android:background="#F0F0F0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/tvPlateSerial"
        app:layout_constraintTop_toBottomOf="@id/tvNumber" />
</androidx.constraintlayout.widget.ConstraintLayout>
