<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="@dimen/space_7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/flPosition"
            android:layout_width="@dimen/space_24"
            android:layout_height="@dimen/space_24"
            android:background="@drawable/bg_number_circle">

            <TextView
                android:id="@+id/tvNumber"
                style="@style/apollo_label4"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="1" />

            <ImageView
                android:id="@+id/ivPositionIcon"
                android:layout_width="@dimen/space_14"
                android:layout_height="@dimen/space_14"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:visibility="gone"
                app:tint="@color/neutral_white" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvPlateSerial"
            style="@style/apollo_body3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_9"
            android:layout_weight="1"
            android:text="@string/l_deab3d2eda" />

        <ImageView
            android:id="@+id/ivPlateStatus"
            android:layout_width="@dimen/space_24"
            android:layout_height="@dimen/space_24"
            android:importantForAccessibility="no"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:id="@+id/vDivider"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="@dimen/space_8"
        android:background="@color/disable_gray" />
</LinearLayout>
