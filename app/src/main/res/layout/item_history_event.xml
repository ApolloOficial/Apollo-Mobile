<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/ivDot"
        android:layout_width="@dimen/space_8"
        android:layout_height="@dimen/space_8"
        android:layout_marginTop="@dimen/space_6"
        android:importantForAccessibility="no"
        android:src="@drawable/bg_dot_active"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/vLine"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_6"
        android:background="@color/disable_gray"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/ivDot"
        app:layout_constraintStart_toStartOf="@id/ivDot"
        app:layout_constraintTop_toBottomOf="@id/ivDot" />

    <TextView
        android:id="@+id/tvTitle"
        style="@style/apollo_label3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/ivDot"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvDescription"
        style="@style/apollo_body3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_6"
        android:lineSpacingExtra="@dimen/space_2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/tvTitle"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <TextView
        android:id="@+id/tvDate"
        style="@style/apollo_body3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:textColor="@color/neutral_gray"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/tvTitle"
        app:layout_constraintTop_toBottomOf="@id/tvDescription" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrierHistory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="tvTitle,tvDescription,tvDate" />

    <Space
        android:layout_width="0dp"
        android:layout_height="@dimen/space_20"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barrierHistory" />

</androidx.constraintlayout.widget.ConstraintLayout>
