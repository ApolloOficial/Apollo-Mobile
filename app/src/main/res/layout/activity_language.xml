<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neutral_white">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/svContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/llBottomArea"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/content_max_width">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_24"
            android:paddingTop="@dimen/space_34"
            android:paddingEnd="@dimen/space_24"
            android:paddingBottom="@dimen/space_32">

            <TextView
                android:id="@+id/tvBack"
                style="@style/apollo_back" />

            <TextView
                style="@style/apollo_h4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_10"
                android:text="Idioma" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:background="@drawable/bg_settings_card"
                android:orientation="vertical"
                android:padding="@dimen/space_16">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/space_50"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivBrazil"
                        android:layout_width="@dimen/space_50"
                        android:layout_height="@dimen/space_50"
                        android:contentDescription="Português (Brasil)"
                        android:src="@drawable/ic_brazil" />

                    <TextView
                        style="@style/apollo_label3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_16"
                        android:layout_weight="1"
                        android:text="Português (Brasil)" />

                    <RadioButton
                        style="@style/apollo_radio"
                        android:id="@+id/rbPortuguese"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:button="@drawable/radio_apollo"
                        android:contentDescription="Português (Brasil)" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="@dimen/space_16"
                    android:background="@color/disable_gray" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/space_50"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivSpain"
                        android:layout_width="@dimen/space_50"
                        android:layout_height="@dimen/space_50"
                        android:contentDescription="Espanõl"
                        android:src="@drawable/ic_spain" />

                    <TextView
                        style="@style/apollo_label3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_16"
                        android:layout_weight="1"
                        android:text="Espanõl" />

                    <RadioButton
                        style="@style/apollo_radio"
                        android:id="@+id/rbSpanish"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:button="@drawable/radio_apollo"
                        android:contentDescription="Espanõl" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="@dimen/space_16"
                    android:background="@color/disable_gray" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/space_50"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivEnglish"
                        android:layout_width="@dimen/space_50"
                        android:layout_height="@dimen/space_50"
                        android:contentDescription="English"
                        android:src="@drawable/ic_usa_uk" />

                    <TextView
                        style="@style/apollo_label3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_16"
                        android:layout_weight="1"
                        android:text="English" />

                    <RadioButton
                        style="@style/apollo_radio"
                        android:id="@+id/rbEnglish"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:button="@drawable/radio_apollo"
                        android:contentDescription="English" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/llBottomArea"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_24"
        android:paddingEnd="@dimen/space_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_max="@dimen/content_max_width">
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
