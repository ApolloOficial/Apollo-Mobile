<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neutral_white">

    <LinearLayout
        android:id="@+id/clHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_24"
        android:paddingTop="@dimen/space_34"
        android:paddingBottom="@dimen/space_15"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/btnBack"
            style="@style/apollo_back" />
    </LinearLayout>

    <View
        android:id="@+id/headerDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/disable_gray"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/clHeader" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerDivider"
        app:layout_constraintWidth_max="@dimen/content_max_width">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_23"
            android:paddingTop="@dimen/space_40"
            android:paddingEnd="@dimen/space_23"
            android:paddingBottom="@dimen/space_32">

            <ImageView
                android:id="@+id/ivSuccessIcon"
                android:layout_width="@dimen/space_58"
                android:layout_height="@dimen/space_58"
                android:layout_gravity="center_horizontal"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_check_green" />

            <TextView
                android:id="@+id/tvTitle"
                style="@style/apollo_h5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_8"
                android:text="Placa identificada!" />

            <TextView
                android:id="@+id/tvSubtitle"
                style="@style/apollo_body2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_2"
                android:text="Dados abaixo vieram do scan"
                android:textColor="@color/neutral_gray" />

            <LinearLayout
                android:id="@+id/llInfoRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:orientation="horizontal">

                <TextView
                    style="@style/apollo_label2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Número de série"
                    android:textColor="@color/neutral_gray" />

                <TextView
                    style="@style/apollo_label2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_16"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:maxLines="1"
                    android:text="CS-2026-00932" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:orientation="horizontal">

                <TextView
                    style="@style/apollo_label2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Modelo"
                    android:textColor="@color/neutral_gray" />

                <TextView
                    style="@style/apollo_label2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_16"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:maxLines="1"
                    android:text="Canadian CS3W-410P" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:orientation="horizontal">

                <TextView
                    style="@style/apollo_label2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Potência de etiqueta"
                    android:textColor="@color/neutral_gray" />

                <TextView
                    style="@style/apollo_label2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_16"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:maxLines="1"
                    android:text="410W" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:orientation="horizontal">

                <TextView
                    style="@style/apollo_label2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Data de aquisição"
                    android:textColor="@color/neutral_gray" />

                <TextView
                    style="@style/apollo_label2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_16"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:maxLines="1"
                    android:text="24/07/2026" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:orientation="horizontal">

                <TextView
                    style="@style/apollo_label2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Inversor / String"
                    android:textColor="@color/neutral_gray" />

                <TextView
                    style="@style/apollo_label2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_16"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:maxLines="1"
                    android:text="Inversor 002 / ITJ-LIM-001" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:orientation="horizontal">

                <TextView
                    style="@style/apollo_label2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Posição"
                    android:textColor="@color/neutral_gray" />

                <TextView
                    style="@style/apollo_label2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_16"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:maxLines="1"
                    android:text="14" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:orientation="horizontal">

                <TextView
                    style="@style/apollo_label2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Eficiência"
                    android:textColor="@color/neutral_gray" />

                <TextView
                    style="@style/apollo_label2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_16"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:maxLines="1"
                    android:text="100%" />
            </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/btnGoToString"
                style="@style/apollo_button_primary"
                android:layout_height="@dimen/space_52"
                android:layout_marginHorizontal="@dimen/space_minus_7"
                android:layout_marginTop="@dimen/space_32"
                android:text="Ir para string ITJ-LIM-001 · CS-2026-00932" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
