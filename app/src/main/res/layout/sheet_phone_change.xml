<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_24"
    android:paddingTop="@dimen/space_16"
    android:paddingEnd="@dimen/space_24"
    android:paddingBottom="@dimen/space_32">

    <View
        android:layout_width="@dimen/space_111"
        android:layout_height="@dimen/space_13"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_sheet_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/apollo_h5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/l_c3dc88e302"
            android:textColor="@color/neutral_black" />

        <ImageView
            android:id="@+id/btnSheetClose"
            android:layout_width="@dimen/space_30"
            android:layout_height="@dimen/space_30"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/l_23781b5ede"
            android:src="@drawable/ic_close_circle" />
    </LinearLayout>

    <TextView
        style="@style/apollo_label3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_20"
        android:text="@string/l_ed5ee5d472"
        android:textColor="@color/neutral_black" />

    <TextView
        android:id="@+id/tvCurrentPhone"
        style="@style/apollo_label3"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_48"
        android:layout_marginTop="@dimen/space_8"
        android:background="@drawable/bg_field_readonly"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/space_16"
        android:text="(85) 9**** - 4321"
        android:textColor="@color/neutral_gray" />

    <TextView
        style="@style/apollo_label3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_20"
        android:text="@string/l_75559a42b4"
        android:textColor="@color/neutral_black" />

    <EditText
        android:id="@+id/etNewPhone"
        style="@style/apollo_label3"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_48"
        android:layout_marginTop="@dimen/space_8"
        android:background="@drawable/edittext_bg"
        android:hint="@string/l_3a4ccd3c4d"
        android:importantForAutofill="no"
        android:inputType="phone"
        android:maxLines="1"
        android:paddingHorizontal="@dimen/space_16"
        android:textColorHint="@color/disable_gray" />

    <TextView
        style="@style/apollo_body4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:lineSpacingExtra="@dimen/space_2"
        android:text="@string/l_1fe034a6f1"
        android:textColor="@color/neutral_gray" />

    <TextView
        android:id="@+id/btnSendPhone"
        style="@style/apollo_button_primary"
        android:layout_marginHorizontal="@dimen/space_minus_8"
        android:layout_marginTop="@dimen/space_24"
        android:text="@string/l_290b081c2b" />
</LinearLayout>
