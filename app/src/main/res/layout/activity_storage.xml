<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neutral_white">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/svContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/llBottomArea"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/content_max_width">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_24"
            android:paddingTop="@dimen/space_42"
            android:paddingEnd="@dimen/space_24"
            android:paddingBottom="@dimen/space_32">

            <TextView
                android:id="@+id/tvBack"
                style="@style/apollo_back" />

            <TextView
                style="@style/apollo_h4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_10"
                android:text="Armazenamento e\ndados offline" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:background="@drawable/bg_settings_card"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

                <TextView
                    android:id="@+id/tvUsoTotal"
                    style="@style/apollo_h6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Uso total" />

                <TextView
                    android:id="@+id/tvStorageAvailable"
                    style="@style/apollo_body4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="56MB de 3GB disponíveis"
                    android:textColor="@color/neutral_gray" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/space_11"
                    android:layout_marginTop="@dimen/space_6">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_tag_small"
                        android:backgroundTint="@color/info_two" />

                    <View
                        android:id="@+id/vStorageApolloBar"
                        android:layout_width="@dimen/space_64"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_tag_small"
                        android:backgroundTint="@color/secondary_three" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_9"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <View
                        android:layout_width="@dimen/space_5"
                        android:layout_height="@dimen/space_5"
                        android:background="@drawable/bg_dot_active"
                        android:backgroundTint="@color/secondary_three" />

                    <TextView
                        style="@style/apollo_body5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_4"
                        android:layout_marginEnd="@dimen/space_9"
                        android:text="Uso do Apollo"
                        android:textSize="@dimen/text_8" />
                    <View
                        android:layout_width="@dimen/space_5"
                        android:layout_height="@dimen/space_5"
                        android:background="@drawable/bg_dot_active"
                        android:backgroundTint="@color/info_two" />

                    <TextView
                        style="@style/apollo_body5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_4"
                        android:layout_marginEnd="@dimen/space_9"
                        android:text="Uso de outros aplicativos"
                        android:textSize="@dimen/text_8" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPlacaTitle"
                    style="@style/apollo_label2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Dados de placa offline" />

                <TextView
                    android:id="@+id/tvPlacaSize"
                    style="@style/apollo_body2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8"
                    android:text="21MB"
                    android:textColor="@color/neutral_gray" />
            </LinearLayout>

            <TextView
                style="@style/apollo_body4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:lineSpacingExtra="@dimen/space_2"
                android:text="Cópia local pra consultar placas sem internet. Limpar não afeta nada já salvo, só que a próxima consulta offline não vai funcionar até sincronizar de novo."
                android:textColor="@color/neutral_gray" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPendingTitle"
                    style="@style/apollo_label2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Registros pendentes (2 itens)" />

                <TextView
                    android:id="@+id/tvPendingSize"
                    style="@style/apollo_body2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8"
                    android:text="35MB"
                    android:textColor="@color/neutral_gray" />
            </LinearLayout>

            <TextView
                style="@style/apollo_body4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:lineSpacingExtra="@dimen/space_2"
                android:text="Manutenções que você já registrou, mas que ainda só existem no seu celular. Ficam guardadas até serem enviadas, não têm opção de exclusão."
                android:textColor="@color/neutral_gray" />

            <TextView
                android:id="@+id/btnClearCache"
                style="@style/apollo_button_outline"
                android:layout_height="@dimen/space_52"
                android:layout_marginHorizontal="@dimen/space_minus_8"
                android:layout_marginTop="@dimen/space_24"
                android:text="Limpar cache de placas"
                android:textColor="@color/neutral_black" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/llBottomArea"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_24"
        android:paddingEnd="@dimen/space_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_max="@dimen/content_max_width">
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
