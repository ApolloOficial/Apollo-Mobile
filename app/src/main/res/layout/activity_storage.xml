<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neutral_white">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/svContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/llBottomArea"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/content_max_width">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_24"
            android:paddingTop="@dimen/space_42"
            android:paddingEnd="@dimen/space_24"
            android:paddingBottom="@dimen/space_32">

            <TextView
                android:id="@+id/tvBack"
                style="@style/apollo_back" />

            <TextView
                style="@style/apollo_h4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_10"
                android:text="@string/l_f63a7ca81e" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:background="@drawable/bg_settings_card"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

                <TextView
                    android:id="@+id/tvUsoTotal"
                    style="@style/apollo_h6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/l_36d3c97b61" />

                <TextView
                    android:id="@+id/tvStorageAvailable"
                    style="@style/apollo_body4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="@string/l_f98fd02e83"
                    android:textColor="@color/neutral_gray" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/space_11"
                    android:layout_marginTop="@dimen/space_6">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_tag_small"
                        android:backgroundTint="@color/info_two" />

                    <View
                        android:id="@+id/vStorageApolloBar"
                        android:layout_width="@dimen/space_64"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_tag_small"
                        android:backgroundTint="@color/secondary_three" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_9"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <View
                        android:layout_width="@dimen/space_5"
                        android:layout_height="@dimen/space_5"
                        android:background="@drawable/bg_dot_active"
                        android:backgroundTint="@color/secondary_three" />

                    <TextView
                        style="@style/apollo_body5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_4"
                        android:layout_marginEnd="@dimen/space_9"
                        android:text="@string/l_6c6db42535"
                        android:textSize="@dimen/text_8" />
                    <View
                        android:layout_width="@dimen/space_5"
                        android:layout_height="@dimen/space_5"
                        android:background="@drawable/bg_dot_active"
                        android:backgroundTint="@color/info_two" />

                    <TextView
                        style="@style/apollo_body5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_4"
                        android:layout_marginEnd="@dimen/space_9"
                        android:text="@string/l_edb40af465"
                        android:textSize="@dimen/text_8" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPlacaTitle"
                    style="@style/apollo_label2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/l_93f976fb32" />

                <TextView
                    android:id="@+id/tvPlacaSize"
                    style="@style/apollo_body2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8"
                    android:text="@string/l_76a1c79132"
                    android:textColor="@color/neutral_gray" />
            </LinearLayout>

            <TextView
                style="@style/apollo_body4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:lineSpacingExtra="@dimen/space_2"
                android:text="@string/l_5e93b8855d"
                android:textColor="@color/neutral_gray" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPendingTitle"
                    style="@style/apollo_label2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/l_899aacbf67" />

                <TextView
                    android:id="@+id/tvPendingSize"
                    style="@style/apollo_body2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8"
                    android:text="@string/l_511c11258e"
                    android:textColor="@color/neutral_gray" />
            </LinearLayout>

            <TextView
                style="@style/apollo_body4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:lineSpacingExtra="@dimen/space_2"
                android:text="@string/l_e8cdbbeb98"
                android:textColor="@color/neutral_gray" />

            <TextView
                android:id="@+id/btnClearCache"
                style="@style/apollo_button_outline"
                android:layout_height="@dimen/space_52"
                android:layout_marginHorizontal="@dimen/space_minus_8"
                android:layout_marginTop="@dimen/space_24"
                android:text="@string/l_5061a6be6b"
                android:textColor="@color/neutral_black" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/llBottomArea"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_24"
        android:paddingEnd="@dimen/space_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_max="@dimen/content_max_width">
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
