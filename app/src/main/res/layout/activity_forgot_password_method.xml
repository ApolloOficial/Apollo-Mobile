<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/ivBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_login" />

    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="@dimen/logo_width"
        android:layout_height="@dimen/logo_height"
        android:layout_marginStart="@dimen/logo_margin_start"
        android:layout_marginTop="@dimen/logo_margin_top"
        android:src="@drawable/logo_white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_white"
        android:paddingStart="@dimen/card_padding_horizontal"
        android:paddingEnd="@dimen/card_padding_horizontal"
        android:paddingTop="@dimen/card_padding_top"
        android:paddingBottom="@dimen/card_padding_bottom"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tvTitle"
            style="@style/apollo_h4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Método de\nautenticação"
            android:textColor="@color/neutral_black"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvSubtitle"
            style="@style/apollo_body2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:text="Escolha um dos contatos abaixo para receber o código de verificação"
            android:textColor="@color/neutral_black"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <LinearLayout
            android:id="@+id/llMethods"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

            <LinearLayout
                android:id="@+id/rowEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_12"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbEmail"
                    style="@style/apollo_radio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/space_52"
                    android:layout_marginStart="@dimen/space_12"
                    android:background="@drawable/edittext_bg"
                    android:paddingHorizontal="@dimen/space_16">

                    <ImageView
                        android:id="@+id/ivMailIcon"
                        android:layout_width="@dimen/space_24"
                        android:layout_height="@dimen/space_24"
                        android:src="@drawable/ic_mail"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvEmailDestination"
                        style="@style/apollo_body3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:text="carlosalves@institucional.com"
                        android:textColor="@color/neutral_black"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/ivMailIcon"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowSms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/cbSms"
                    style="@style/apollo_radio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/space_52"
                    android:layout_marginStart="@dimen/space_12"
                    android:background="@drawable/edittext_bg"
                    android:paddingHorizontal="@dimen/space_16">

                    <ImageView
                        android:id="@+id/ivSmsIcon"
                        android:layout_width="@dimen/space_24"
                        android:layout_height="@dimen/space_24"
                        android:src="@drawable/ic_chat"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvSmsDestination"
                        style="@style/apollo_body3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:text="(85) 98765 - 4321"
                        android:textColor="@color/neutral_black"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/ivSmsIcon"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btnContinue"
            style="@style/apollo_label2"
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_52"
            android:layout_marginTop="@dimen/space_24"
            app:backgroundTint="@color/cta_fill_tint"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Continuar"
            android:textAllCaps="false"
            android:textColor="@color/cta_filled_text"
            app:cornerRadius="@dimen/space_28"
            app:layout_constraintTop_toBottomOf="@id/llMethods" />

        <Button
            android:id="@+id/btnBack"
            style="@style/apollo_label2"
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_52"
            android:layout_marginTop="@dimen/space_12"
            android:layout_marginBottom="@dimen/space_8"
            android:background="@drawable/btn_outlined"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Voltar"
            android:textAllCaps="false"
            android:textColor="@color/neutral_black"
            app:backgroundTint="@null"
            app:cornerRadius="@dimen/space_28"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnContinue" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
