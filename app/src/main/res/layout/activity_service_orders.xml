<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neutral_white">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/topBar"
        android:name="org.apollo.mobile.view.common.TopBarFragment"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/content_max_width" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintWidth_max="@dimen/content_max_width">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_11"
            android:paddingTop="@dimen/space_16"
            android:paddingEnd="@dimen/space_11"
            android:paddingBottom="@dimen/content_bottom_padding">

            <TextView
                android:id="@+id/btnBack"
                style="@style/apollo_back"
                android:layout_marginStart="@dimen/space_5" />

            <TextView
                android:id="@+id/tvTitle"
                style="@style/apollo_h4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_5"
                android:layout_marginTop="@dimen/space_10"
                android:text="Ordens de serviço" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_16"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipAll"
                    style="@style/apollo_filter_chip"
                    android:text="Todas" />

                <TextView
                    android:id="@+id/chipOpen"
                    style="@style/apollo_filter_chip"
                    android:text="Aberta" />

                <TextView
                    android:id="@+id/chipInProgress"
                    style="@style/apollo_filter_chip"
                    android:layout_marginEnd="0dp"
                    android:text="Em andamento" />
            </LinearLayout>

            <org.apollo.mobile.view.common.SkeletonView
        android:id="@+id/progressOrders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_8"
                android:visibility="gone" />

            <include
                android:id="@+id/llEmptyOrders"
                layout="@layout/view_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/service_orders_list_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include layout="@layout/layout_bottom_nav" />

</androidx.constraintlayout.widget.ConstraintLayout>
