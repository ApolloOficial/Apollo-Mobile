<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neutral_white">

    <!-- Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/screen_horizontal_padding"
        android:paddingTop="@dimen/header_top_padding"
        android:paddingBottom="@dimen/header_bottom_padding"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivProfile"
            android:layout_width="@dimen/header_control_size"
            android:layout_height="@dimen/header_control_size"
            android:scaleType="centerCrop"
            android:src="@drawable/profile_picture"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

        <TextView
            android:id="@+id/tvLocation"
            style="@style/apollo_label4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/header_item_spacing"
            android:layout_marginEnd="@dimen/header_item_spacing"
            android:background="@drawable/edittext_bg"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="@dimen/space_16"
            android:paddingVertical="@dimen/space_8"
            android:text="Fábrica Itajaí, Limeira - SP"
            android:textColor="@color/neutral_black"
            app:layout_constraintBottom_toBottomOf="@id/ivProfile"
            app:layout_constraintEnd_toStartOf="@id/ibNotifications"
            app:layout_constraintStart_toEndOf="@id/ivProfile"
            app:layout_constraintTop_toTopOf="@id/ivProfile" />

        <ImageButton
            android:id="@+id/ibNotifications"
            android:layout_width="@dimen/header_control_size"
            android:layout_height="@dimen/header_control_size"
            android:background="@drawable/edittext_bg"
            android:src="@drawable/ic_notifications"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/topBar"
        android:name="org.apollo.mobile.view.common.TopBarFragment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_horizontal_padding"
            android:paddingBottom="@dimen/content_bottom_padding">

            <!-- Back Button -->
            <LinearLayout
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="@dimen/space_16"
                    android:layout_height="@dimen/space_16"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/neutral_black" />

                <TextView
                    style="@style/apollo_label3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8"
                    android:text="Voltar"
                    android:textColor="@color/neutral_black" />
            </LinearLayout>

            <!-- Inverter Info -->
            <TextView
                android:id="@+id/tvInverterIdDetail"
                style="@style/apollo_h4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:text="ITJ-LIM-001"
                android:textColor="@color/neutral_black" />

            <TextView
                android:id="@+id/tvInverterSummaryDetail"
                style="@style/apollo_body2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Capac. 42 kWp · 24 placas"
                android:textColor="@color/neutral_gray" />

            <!-- Search Section -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24">

                <TextView
                    android:id="@+id/tvPlacasLabel"
                    style="@style/apollo_h5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Placas"
                    android:textColor="@color/neutral_black"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="@dimen/space_40"
                    android:layout_marginStart="@dimen/space_16"
                    android:background="@drawable/edittext_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/space_12"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/tvPlacasLabel"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="@dimen/space_18"
                        android:layout_height="@dimen/space_18"
                        android:src="@drawable/ic_search"
                        app:tint="@color/secondary_three" />

                    <EditText
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:hint="Buscar por número de série..."
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:paddingStart="@dimen/space_8"
                        android:textSize="@dimen/text_12" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Filters -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_20"
                android:scrollbars="none"
                android:overScrollMode="never">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipAll"
                        style="@style/apollo_label4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_filter_chip"
                        android:paddingHorizontal="@dimen/space_16"
                        android:paddingVertical="@dimen/space_5"
                        android:text="Todas"
                        android:textColor="@color/selector_filter_text"
                        android:state_selected="true"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/chipStock"
                        style="@style/apollo_label4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_8"
                        android:background="@drawable/bg_filter_chip"
                        android:paddingHorizontal="@dimen/space_16"
                        android:paddingVertical="@dimen/space_5"
                        android:text="Em estoque"
                        android:textColor="@color/selector_filter_text"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/chipInUse"
                        style="@style/apollo_label4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_8"
                        android:background="@drawable/bg_filter_chip"
                        android:paddingHorizontal="@dimen/space_16"
                        android:paddingVertical="@dimen/space_5"
                        android:text="Em uso"
                        android:textColor="@color/selector_filter_text"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/chipAttention"
                        style="@style/apollo_label4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_8"
                        android:background="@drawable/bg_filter_chip"
                        android:paddingHorizontal="@dimen/space_16"
                        android:paddingVertical="@dimen/space_5"
                        android:text="Atenção"
                        android:textColor="@color/selector_filter_text"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>
            </HorizontalScrollView>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/space_16"
                android:background="#F0F0F0" />

            <!-- Plates List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPlatesDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:nestedScrollingEnabled="false"
                tools:itemCount="3"
                tools:listitem="@layout/item_plate_detail" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Footer + chatbot compartilhados -->
    <include layout="@layout/layout_bottom_nav" />

</androidx.constraintlayout.widget.ConstraintLayout>
