<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neutral_white">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/topBar"
        android:name="org.apollo.mobile.view.common.TopBarFragment"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/content_max_width" />

    <TextView
        android:id="@+id/tvLocation"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/llDetailsHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_horizontal_padding"
        android:paddingTop="@dimen/space_16"
        android:paddingEnd="@dimen/screen_horizontal_padding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintWidth_max="@dimen/content_max_width">

        <TextView
            android:id="@+id/btnBack"
            style="@style/apollo_back" />

        <TextView
            android:id="@+id/tvInverterIdDetail"
            style="@style/apollo_h5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_10"
            android:text="@string/l_307299e0a8" />

        <TextView
            android:id="@+id/tvHealthDetail"
            style="@style/apollo_h6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_10"
            android:text="@string/l_e935292c08"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvInverterSummaryDetail"
            style="@style/apollo_label2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:text="@string/l_9bdaeb416f"
            android:textColor="@color/neutral_gray" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPlacasLabel"
                style="@style/apollo_h6"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/l_1a1a776e9f" />

            <LinearLayout style="@style/apollo_search_pill">

                <ImageView
                    android:layout_width="@dimen/space_24"
                    android:layout_height="@dimen/space_24"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_search" />

                <EditText
                    android:id="@+id/etSearch"
                    style="@style/apollo_body4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/space_8"
                    android:background="@null"
                    android:hint="@string/l_7507bf4b28"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColorHint="@color/neutral_gray" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/hsFilters"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_24"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="@dimen/space_18"
        android:paddingEnd="@dimen/space_18"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llDetailsHeader"
        app:layout_constraintWidth_max="@dimen/content_max_width">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipAll"
                style="@style/apollo_filter_chip"
                android:text="@string/l_f28c2b459d" />

            <TextView
                android:id="@+id/chipStock"
                style="@style/apollo_filter_chip"
                android:text="@string/l_1783c970b4" />

            <TextView
                android:id="@+id/chipInUse"
                style="@style/apollo_filter_chip"
                android:text="@string/l_5171bff63a" />

            <TextView
                android:id="@+id/chipAttention"
                style="@style/apollo_filter_chip"
                android:text="@string/l_d45f3feee7" />
        </LinearLayout>
    </HorizontalScrollView>

    <View
        android:id="@+id/vFiltersDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/space_16"
        android:background="@color/disable_gray"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/hsFilters" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPlatesDetail"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:layoutAnimation="@anim/layout_list_enter"
        android:overScrollMode="never"
        android:paddingStart="@dimen/space_12"
        android:paddingTop="@dimen/space_16"
        android:paddingEnd="@dimen/space_12"
        android:paddingBottom="@dimen/content_bottom_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/vFiltersDivider"
        app:layout_constraintWidth_max="@dimen/content_max_width" />

    <org.apollo.mobile.view.common.SkeletonView
        android:id="@+id/skeletonPanelDetails"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:max="5"
        android:background="?android:attr/colorBackground"
        android:paddingHorizontal="@dimen/screen_horizontal_padding"
        android:paddingTop="@dimen/space_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/vFiltersDivider"
        app:layout_constraintWidth_max="@dimen/content_max_width" />


    <include
        android:id="@+id/llPlatesEmpty"
        layout="@layout/view_empty_state"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_24"
        android:layout_marginTop="@dimen/space_32"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/vFiltersDivider" />

    <include layout="@layout/layout_bottom_nav" />

</androidx.constraintlayout.widget.ConstraintLayout>
