<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neutral_white">

    <!-- Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="32dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivProfile"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:scaleType="centerCrop"
            android:src="@drawable/profile_picture"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

        <TextView
            android:id="@+id/tvLocation"
            style="@style/apollo_label4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/edittext_bg"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="Fábrica Itajaí, Limeira - SP"
            android:textColor="@color/neutral_black"
            app:layout_constraintBottom_toBottomOf="@id/ivProfile"
            app:layout_constraintEnd_toStartOf="@id/ibNotifications"
            app:layout_constraintStart_toEndOf="@id/ivProfile"
            app:layout_constraintTop_toTopOf="@id/ivProfile" />

        <ImageButton
            android:id="@+id/ibNotifications"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/edittext_bg"
            android:src="@drawable/ic_notifications"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/headerDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F0F0F0"
        app:layout_constraintTop_toBottomOf="@id/clHeader" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerDivider">

        <ImageView
            android:id="@+id/ivErrorIllustration"
            android:layout_width="162dp"
            android:layout_height="180dp"
            android:src="@drawable/image_error_phone_guy" />

        <TextView
            android:id="@+id/tvErrorTitle"
            style="@style/apollo_h4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:text="@string/error_unexpected_title"
            android:textColor="@color/neutral_black"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvErrorDescription"
            style="@style/apollo_body2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/error_unexpected_description"
            android:textColor="@color/neutral_gray" />

        <Button
            android:id="@+id/btnTryAgain"
            style="@style/apollo_label2"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="40dp"
            android:backgroundTint="@color/secondary_three"
            android:text="@string/error_btn_try_again"
            android:textAllCaps="false"
            android:textColor="@color/neutral_white"
            app:cornerRadius="@dimen/button_corner_radius" />

        <Button
            android:id="@+id/btnSupport"
            style="@style/apollo_label2"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="12dp"
            android:background="@drawable/btn_outlined"
            android:text="@string/error_btn_support"
            android:textAllCaps="false"
            android:textColor="@color/secondary_one"
            app:backgroundTint="@null"
            app:cornerRadius="@dimen/button_corner_radius" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
