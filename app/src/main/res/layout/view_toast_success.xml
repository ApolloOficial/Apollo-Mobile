<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/llAppToast"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_toast_success"
    android:elevation="@dimen/space_4"
    android:gravity="center_vertical"
    android:minHeight="53dp"
    android:orientation="horizontal"
    android:paddingStart="24dp"
    android:paddingEnd="16dp">

    <ImageView
        android:id="@+id/ivAppToastIcon"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_toast_success" />

    <TextView
        android:id="@+id/tvAppToast"
        style="@style/apollo_label3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:lineSpacingExtra="2dp"
        android:paddingVertical="10dp"
        android:textColor="#FF1C1C1C"
        android:text="@string/l_c9304939cb" />
</LinearLayout>
