<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/llAppToast"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/space_27"
    android:background="@drawable/bg_toast_success"
    android:elevation="@dimen/space_8"
    android:gravity="center_vertical"
    android:minHeight="@dimen/space_53"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_24"
    android:paddingEnd="@dimen/space_16">

    <ImageView
        android:id="@+id/ivAppToastIcon"
        android:layout_width="@dimen/space_26"
        android:layout_height="@dimen/space_26"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_check_green" />

    <TextView
        android:id="@+id/tvAppToast"
        style="@style/apollo_label3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_16"
        android:layout_weight="1"
        android:paddingVertical="@dimen/space_12"
        android:text="Placa instalada com sucesso!" />
</LinearLayout>
