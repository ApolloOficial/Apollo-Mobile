<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingVertical="@dimen/space_24">

    <ImageView
        android:id="@+id/ivEmptyIllustration"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/space_140"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:maxWidth="@dimen/space_280"
        android:scaleType="fitCenter"
        android:src="@drawable/empty_orders" />

    <TextView
        android:id="@+id/tvEmptyTitle"
        style="@style/apollo_h5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_24"
        android:gravity="center"
        android:textColor="@color/neutral_black"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvEmptyMessage"
        style="@style/apollo_body3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:gravity="center"
        android:lineSpacingExtra="@dimen/space_2"
        android:maxWidth="@dimen/space_300"
        android:text="Nenhuma OS encontrada."
        android:textColor="@color/neutral_gray" />

    <TextView
        android:id="@+id/btnEmptyRetry"
        style="@style/apollo_button_primary"
        android:layout_marginTop="@dimen/space_24"
        android:text="Tentar novamente"
        android:visibility="gone" />

    <TextView
        android:id="@+id/btnEmptySupport"
        style="@style/apollo_button_outline"
        android:layout_marginTop="@dimen/space_12"
        android:text="Falar com o suporte"
        android:textColor="@color/secondary_three"
        android:visibility="gone" />
</LinearLayout>
