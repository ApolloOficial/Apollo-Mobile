<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_12"
    app:cardBackgroundColor="@color/neutral_white"
    app:cardCornerRadius="@dimen/space_20"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/card_content_padding">

        <TextView
            android:id="@+id/tvSubtitle"
            style="@style/apollo_label2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/neutral_gray"
            tools:text="Placa CS-2024-00765" />

        <TextView
            android:id="@+id/tvMainId"
            style="@style/apollo_h5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:textColor="@color/neutral_black"
            android:textStyle="bold"
            tools:text="OS84524" />

        <TextView
            android:id="@+id/tvTag"
            style="@style/apollo_label6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:background="@drawable/bg_label_rounded"
            android:backgroundTint="@color/alert_two"
            android:paddingHorizontal="@dimen/space_12"
            android:paddingVertical="@dimen/space_6"
            android:text="Preventiva"
            android:textColor="@color/neutral_black" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDate"
                style="@style/apollo_body4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_8"
                android:layout_weight="1"
                android:textColor="@color/neutral_gray"
                tools:text="30/07/2026" />

            <Button
                android:id="@+id/btnDetails"
                style="@style/apollo_label3"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target_min_size"
                android:background="@drawable/btn_outlined"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="@dimen/space_16"
                android:text="@string/maintenance_btn_view_details"
                android:textAllCaps="false"
                android:textColor="@color/secondary_three"
                app:backgroundTint="@null"
                app:cornerRadius="@dimen/space_24" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
