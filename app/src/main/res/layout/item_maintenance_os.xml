<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_8"
    android:background="@drawable/bg_surface_card"
    android:foreground="?attr/selectableItemBackground"
    android:paddingStart="@dimen/space_16"
    android:paddingTop="@dimen/space_16"
    android:paddingEnd="@dimen/space_16"
    android:paddingBottom="@dimen/space_16">

    <TextView
        android:id="@+id/tvSubtitle"
        style="@style/apollo_label2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Placa CS-2024-00765"
        android:textColor="@color/neutral_gray"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvMainId"
        style="@style/apollo_h5"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_6"
        android:layout_marginEnd="@dimen/space_8"
        android:text="OS84524"
        app:layout_constraintEnd_toStartOf="@id/tvTag"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle" />

    <TextView
        android:id="@+id/tvTag"
        style="@style/apollo_tag"
        android:backgroundTint="@color/alert_two"
        android:minWidth="@dimen/space_80"
        android:text="Preventiva"
        app:layout_constraintBottom_toBottomOf="@id/tvMainId"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/btnDetails"
        style="@style/apollo_cta_outline"
        android:layout_marginTop="@dimen/space_9"
        android:text="Ver detalhes"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvMainId" />

    <TextView
        android:id="@+id/tvDate"
        style="@style/apollo_body4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/space_8"
        android:text="30/07/2026"
        android:textColor="@color/neutral_gray"
        app:layout_constraintBottom_toBottomOf="@id/btnDetails"
        app:layout_constraintEnd_toStartOf="@id/btnDetails"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnDetails" />

</androidx.constraintlayout.widget.ConstraintLayout>
