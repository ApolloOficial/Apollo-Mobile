<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/neutral_white"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvSubtitle"
            style="@style/apollo_label2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Placa CS-2024-00765"
            android:textColor="@color/neutral_gray"
            app:layout_constraintEnd_toStartOf="@+id/tvTag"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvMainId"
            style="@style/apollo_h5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="OS84524"
            android:textColor="@color/neutral_black"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/tvTag"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle" />

        <TextView
            android:id="@+id/tvTag"
            style="@style/apollo_label6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_label_rounded"
            android:backgroundTint="@color/alert_two"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="Preventiva"
            android:textColor="@color/neutral_black"
            app:layout_constraintBottom_toBottomOf="@+id/tvMainId"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvSubtitle"
            app:layout_constraintVertical_bias="0.8" />

        <TextView
            android:id="@+id/tvDate"
            style="@style/apollo_body4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="30/07/2026"
            android:textColor="@color/neutral_gray"
            app:layout_constraintBottom_toBottomOf="@+id/btnDetails"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/btnDetails" />

        <Button
            android:id="@+id/btnDetails"
            style="@style/apollo_label3"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/btn_outlined"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="20dp"
            android:text="Ver detalhes"
            android:textAllCaps="false"
            android:textColor="@color/secondary_three"
            app:backgroundTint="@null"
            app:cornerRadius="17dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvMainId" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>