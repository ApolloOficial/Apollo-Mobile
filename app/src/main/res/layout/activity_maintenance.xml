<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neutral_white">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/topBar"
        android:name="org.apollo.mobile.view.common.TopBarFragment"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/content_max_width" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintWidth_max="@dimen/content_max_width">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_12"
            android:paddingTop="@dimen/space_24"
            android:paddingEnd="@dimen/space_12"
            android:paddingBottom="@dimen/content_bottom_padding">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_4"
                android:background="@drawable/bg_surface_card"
                android:paddingStart="@dimen/space_24"
                android:paddingTop="@dimen/space_16"
                android:paddingEnd="@dimen/space_16"
                android:paddingBottom="@dimen/space_16">

                <FrameLayout
                    android:id="@+id/cvOsIcon"
                    android:layout_width="@dimen/space_74"
                    android:layout_height="@dimen/space_74"
                    android:background="@drawable/bg_icon_box"
                    android:backgroundTint="#4DFFC8A8"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="@dimen/space_48"
                        android:layout_height="@dimen/space_48"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_work_order" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvOsTitle"
                    style="@style/apollo_label1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_16"
                    android:layout_marginTop="@dimen/space_3"
                    android:text="@string/l_023f8fcdbd"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/cvOsIcon"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvOsSummary"
                    style="@style/apollo_body3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="@string/l_547738db37"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/tvOsTitle"
                    app:layout_constraintTop_toBottomOf="@id/tvOsTitle" />

                <TextView
                    android:id="@+id/btnVerOrdens"
                    style="@style/apollo_cta_filled"
                    android:layout_marginTop="@dimen/space_16"
                    android:text="@string/l_216605fe9a"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvOsSummary" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_4"
                android:paddingEnd="@dimen/space_4">

                <TextView
                    android:id="@+id/tvHistoryTitle"
                    style="@style/apollo_h5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/l_67748f8e52" />

                <LinearLayout style="@style/apollo_search_pill">

                    <ImageView
                        android:layout_width="@dimen/space_24"
                        android:layout_height="@dimen/space_24"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_search" />

                    <EditText
                        android:id="@+id/etMaintenanceSearch"
                        style="@style/apollo_body4"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/space_8"
                        android:background="@null"
                        android:hint="@string/l_472e30c7e0"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:textColorHint="@color/neutral_gray" />
                </LinearLayout>
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_20"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipMaintenanceAll"
                        style="@style/apollo_filter_chip"
                        android:text="@string/l_f28c2b459d" />

                    <TextView
                        android:id="@+id/chipMaintenancePreventive"
                        style="@style/apollo_filter_chip"
                        android:text="@string/l_1cc3a8b8fd" />

                    <TextView
                        android:id="@+id/chipMaintenanceCorrective"
                        style="@style/apollo_filter_chip"
                        android:text="@string/l_0f48211088" />

                    <TextView
                        android:id="@+id/chipMaintenancePredictive"
                        style="@style/apollo_filter_chip"
                        android:text="@string/l_30be503b85" />
                </LinearLayout>
            </HorizontalScrollView>

            <org.apollo.mobile.view.common.SkeletonView
        android:id="@+id/progressMaintenanceHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_8"
                android:visibility="gone" />

            <include
                android:id="@+id/llMaintenanceEmpty"
                layout="@layout/view_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_4"
                android:layout_marginTop="@dimen/space_16"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/maintenanceHistoryList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include layout="@layout/layout_bottom_nav" />

</androidx.constraintlayout.widget.ConstraintLayout>
