<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neutral_white">

    <!-- Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/screen_horizontal_padding"
        android:paddingTop="@dimen/header_top_padding"
        android:paddingBottom="@dimen/header_bottom_padding"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivProfile"
            android:layout_width="@dimen/header_control_size"
            android:layout_height="@dimen/header_control_size"
            android:scaleType="centerCrop"
            android:src="@drawable/profile_picture"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

        <TextView
            android:id="@+id/tvLocation"
            style="@style/apollo_label4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/header_item_spacing"
            android:layout_marginEnd="@dimen/header_item_spacing"
            android:background="@drawable/edittext_bg"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="@dimen/space_12"
            android:paddingVertical="@dimen/space_6"
            android:text="Fábrica Itajaí, Limeira - SP"
            android:textColor="@color/neutral_black"
            app:layout_constraintBottom_toBottomOf="@id/ivProfile"
            app:layout_constraintEnd_toStartOf="@id/ibNotifications"
            app:layout_constraintStart_toEndOf="@id/ivProfile"
            app:layout_constraintTop_toTopOf="@id/ivProfile" />

        <ImageButton
            android:id="@+id/ibNotifications"
            android:layout_width="@dimen/header_control_size"
            android:layout_height="@dimen/header_control_size"
            android:background="@drawable/edittext_bg"
            android:src="@drawable/ic_notifications"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/topBar"
        android:name="org.apollo.mobile.view.common.TopBarFragment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_horizontal_padding"
            android:paddingBottom="@dimen/content_bottom_padding">

            <!-- OS Overview Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                app:cardBackgroundColor="@color/neutral_white"
                app:cardCornerRadius="@dimen/space_20"
                app:cardElevation="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/card_content_padding">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cvOsIcon"
                        android:layout_width="@dimen/os_overview_icon_size"
                        android:layout_height="@dimen/os_overview_icon_size"
                        app:cardBackgroundColor="#FFF1ED"
                        app:cardCornerRadius="@dimen/space_18"
                        app:cardElevation="0dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:layout_width="@dimen/os_overview_icon_inner_size"
                            android:layout_height="@dimen/os_overview_icon_inner_size"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_clipboard"
                            app:tint="@color/secondary_three" />

                    </androidx.cardview.widget.CardView>

                    <TextView
                        android:id="@+id/tvOsTitle"
                        style="@style/apollo_label1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_14"
                        android:text="@string/maintenance_os_card_title"
                        android:textColor="@color/neutral_black"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/cvOsIcon"
                        app:layout_constraintTop_toTopOf="@id/cvOsIcon" />

                    <TextView
                        android:id="@+id/tvOsSummary"
                        style="@style/apollo_body4"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_14"
                        android:layout_marginTop="2dp"
                        android:text="@string/maintenance_os_summary"
                        android:textColor="@color/neutral_gray"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/cvOsIcon"
                        app:layout_constraintTop_toBottomOf="@id/tvOsTitle" />

                    <Button
                        android:id="@+id/btnVerOrdens"
                        style="@style/apollo_label3"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/touch_target_min_size"
                        android:layout_marginTop="@dimen/space_8"
                        android:backgroundTint="@color/secondary_three"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingHorizontal="@dimen/space_16"
                        android:text="@string/maintenance_btn_orders"
                        android:textAllCaps="false"
                        android:textColor="@color/neutral_white"
                        app:cornerRadius="@dimen/space_24"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvOsSummary" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

            <!-- History Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_spacing"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvHistoryTitle"
                    style="@style/apollo_h5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Histórico"
                    android:textColor="@color/neutral_black"
                    android:textStyle="bold"
                    />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/space_48"
                    android:layout_marginTop="@dimen/space_12"
                    android:background="@drawable/edittext_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/space_12"
                    >

                    <ImageView
                        android:layout_width="@dimen/space_16"
                        android:layout_height="@dimen/space_16"
                        android:src="@drawable/ic_search"
                        app:tint="@color/secondary_three" />

                    <EditText
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:hint="@string/maintenance_search_hint"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:paddingStart="@dimen/space_6"
                        android:textColorHint="@color/neutral_gray"
                        android:textSize="@dimen/text_14" />
                </LinearLayout>

            </LinearLayout>

            <!-- Filters -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="@dimen/space_4">

                    <TextView
                        android:id="@+id/chipMaintenanceAll"
                        style="@style/apollo_label4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_label_rounded"
                        android:backgroundTint="@color/secondary_three"
                        android:paddingHorizontal="@dimen/space_18"
                        android:paddingVertical="@dimen/space_6"
                        android:text="@string/maintenance_filter_all"
                        android:textColor="@color/neutral_white" />

                    <TextView
                        android:id="@+id/chipMaintenancePreventive"
                        style="@style/apollo_label4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_8"
                        android:background="@drawable/bg_label_rounded"
                        android:backgroundTint="#EBEBEB"
                        android:paddingHorizontal="@dimen/space_18"
                        android:paddingVertical="@dimen/space_6"
                        android:text="@string/maintenance_filter_preventive"
                        android:textColor="@color/neutral_gray" />

                    <TextView
                        android:id="@+id/chipMaintenanceCorrective"
                        style="@style/apollo_label4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_8"
                        android:background="@drawable/bg_label_rounded"
                        android:backgroundTint="#EBEBEB"
                        android:paddingHorizontal="@dimen/space_18"
                        android:paddingVertical="@dimen/space_6"
                        android:text="@string/maintenance_filter_corrective"
                        android:textColor="@color/neutral_gray" />

                    <TextView
                        android:id="@+id/chipMaintenancePredictive"
                        style="@style/apollo_label4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_8"
                        android:background="@drawable/bg_label_rounded"
                        android:backgroundTint="#EBEBEB"
                        android:paddingHorizontal="@dimen/space_18"
                        android:paddingVertical="@dimen/space_6"
                        android:text="@string/maintenance_filter_predictive"
                        android:textColor="@color/neutral_gray" />

                </LinearLayout>
            </HorizontalScrollView>

            <ProgressBar
                android:id="@+id/progressMaintenanceHistory"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_24" />

            <TextView
                android:id="@+id/tvMaintenanceEmpty"
                style="@style/apollo_body2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_32"
                android:gravity="center"
                android:text="Nenhuma OS encontrada."
                android:textColor="@color/neutral_gray"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/maintenanceHistoryList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_18"
                android:orientation="vertical" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Footer + chatbot compartilhados -->
    <include layout="@layout/layout_bottom_nav" />

</androidx.constraintlayout.widget.ConstraintLayout>
