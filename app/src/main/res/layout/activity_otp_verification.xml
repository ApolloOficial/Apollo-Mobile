<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/ivBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_login" />

    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="@dimen/logo_width"
        android:layout_height="@dimen/logo_height"
        android:layout_marginStart="@dimen/logo_margin_start"
        android:layout_marginTop="@dimen/logo_margin_top"
        android:src="@drawable/logo_white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_white"
        android:paddingStart="@dimen/card_padding_horizontal"
        android:paddingEnd="@dimen/card_padding_horizontal"
        android:paddingTop="@dimen/card_padding_top"
        android:paddingBottom="@dimen/card_padding_bottom"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tvTitle"
            style="@style/apollo_auth_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/l_932cfacdfa"
            android:textColor="@color/neutral_black"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvSubtitle"
            style="@style/apollo_h5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:gravity="center"
            android:text="(85) 98765 – 4321"
            android:textColor="@color/neutral_black"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <TextView
            android:id="@+id/tvChangeMethod"
            style="@style/apollo_label4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/l_a30dd8c853"
            android:textColor="@color/secondary_three"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle" />

        <LinearLayout
            android:id="@+id/llOtpContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/tvChangeMethod">

            <EditText
                android:layout_width="0dp"
                android:layout_height="@dimen/space_56"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/space_6"
                android:background="@drawable/otp_box_bg"
                android:gravity="center"
                android:hint="–"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/neutral_black"
                android:textColorHint="@color/disable_gray"
                android:textSize="@dimen/text_22"
                android:textStyle="bold" />

            <EditText
                android:layout_width="0dp"
                android:layout_height="@dimen/space_56"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/space_6"
                android:background="@drawable/otp_box_bg"
                android:gravity="center"
                android:hint="–"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/neutral_black"
                android:textColorHint="@color/disable_gray"
                android:textSize="@dimen/text_22"
                android:textStyle="bold" />

            <EditText
                android:layout_width="0dp"
                android:layout_height="@dimen/space_56"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/space_6"
                android:background="@drawable/otp_box_bg"
                android:gravity="center"
                android:hint="–"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/neutral_black"
                android:textColorHint="@color/disable_gray"
                android:textSize="@dimen/text_22"
                android:textStyle="bold" />

            <EditText
                android:layout_width="0dp"
                android:layout_height="@dimen/space_56"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/space_6"
                android:background="@drawable/otp_box_bg"
                android:gravity="center"
                android:hint="–"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/neutral_black"
                android:textColorHint="@color/disable_gray"
                android:textSize="@dimen/text_22"
                android:textStyle="bold" />

            <EditText
                android:layout_width="0dp"
                android:layout_height="@dimen/space_56"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/space_6"
                android:background="@drawable/otp_box_bg"
                android:gravity="center"
                android:hint="–"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/neutral_black"
                android:textColorHint="@color/disable_gray"
                android:textSize="@dimen/text_22"
                android:textStyle="bold" />

            <EditText
                android:layout_width="0dp"
                android:layout_height="@dimen/space_56"
                android:layout_weight="1"
                android:background="@drawable/otp_box_bg"
                android:gravity="center"
                android:hint="–"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/neutral_black"
                android:textColorHint="@color/disable_gray"
                android:textSize="@dimen/text_22"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvResend"
            style="@style/apollo_body4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/l_6699fb1955"
            android:textColor="@color/neutral_gray"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/llOtpContainer" />

        <Button
            android:id="@+id/btnContinue"
            style="@style/apollo_label2"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_24"
            app:backgroundTint="@color/cta_fill_tint"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/l_64b467714a"
            android:textAllCaps="false"
            android:textColor="@color/cta_filled_text"
            app:cornerRadius="@dimen/button_corner_radius"
            app:layout_constraintTop_toBottomOf="@id/tvResend" />

        <Button
            android:id="@+id/btnBack"
            style="@style/apollo_label2"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_12"
            android:layout_marginBottom="@dimen/space_8"
            android:background="@drawable/btn_outlined"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/l_04b2b63394"
            android:textAllCaps="false"
            android:textColor="@color/neutral_black"
            app:backgroundTint="@null"
            app:cornerRadius="@dimen/button_corner_radius"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnContinue" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>