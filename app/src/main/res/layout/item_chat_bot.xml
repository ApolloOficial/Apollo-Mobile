<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/space_16"
    android:paddingTop="@dimen/space_8"
    android:paddingEnd="@dimen/space_16"
    android:paddingBottom="@dimen/space_16">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_bot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.63" />

    <LinearLayout
        android:id="@+id/llBotBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chat_bot"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_20"
        android:paddingTop="@dimen/space_16"
        android:paddingEnd="@dimen/space_20"
        android:paddingBottom="@dimen/space_12"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="@id/guideline_bot"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvBotMessage"
            style="@style/apollo_body4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="@dimen/space_2"
            android:textColor="@color/neutral_black" />

        <TextView
            android:id="@+id/tvBotSources"
            style="@style/apollo_body5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:textColor="@color/neutral_gray"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/space_8"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivCopyBot"
                android:layout_width="@dimen/space_20"
                android:layout_height="@dimen/space_20"
                android:layout_marginEnd="@dimen/space_8"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/chat_copy"
                android:src="@drawable/ic_copypaste"
                app:tint="@color/neutral_gray" />

            <ImageView
                android:id="@+id/ivSpeakBot"
                android:layout_width="@dimen/space_20"
                android:layout_height="@dimen/space_20"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/chat_speak"
                android:src="@drawable/ic_sound"
                app:tint="@color/neutral_gray" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:layout_width="@dimen/space_16"
        android:layout_height="@dimen/space_12"
        android:layout_marginStart="@dimen/space_minus_1"
        android:layout_marginTop="@dimen/space_minus_10"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_bubble_tail_bot"
        app:layout_constraintStart_toStartOf="@id/llBotBubble"
        app:layout_constraintTop_toBottomOf="@id/llBotBubble" />

</androidx.constraintlayout.widget.ConstraintLayout>
