<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/space_16"
    android:paddingTop="@dimen/space_8"
    android:paddingEnd="@dimen/space_48"
    android:paddingBottom="@dimen/space_16">

    <LinearLayout
        android:id="@+id/llBotBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_20"
        android:paddingTop="@dimen/space_16"
        android:paddingEnd="@dimen/space_20"
        android:paddingBottom="@dimen/space_12">

        <TextView
            android:id="@+id/tvBotMessage"
            style="@style/apollo_body4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="@dimen/space_2"
            android:textColor="@color/neutral_black" />

        <TextView
            android:id="@+id/tvBotSources"
            style="@style/apollo_body5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:textColor="@color/neutral_gray"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/space_8"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivCopyBot"
                android:layout_width="@dimen/space_20"
                android:layout_height="@dimen/space_20"
                android:layout_marginEnd="@dimen/space_8"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/chat_copy"
                android:src="@drawable/ic_copypaste"
                app:tint="@color/neutral_gray" />

            <ImageView
                android:id="@+id/ivSpeakBot"
                android:layout_width="@dimen/space_20"
                android:layout_height="@dimen/space_20"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/chat_speak"
                android:src="@drawable/ic_sound"
                app:tint="@color/neutral_gray" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
