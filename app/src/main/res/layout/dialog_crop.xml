<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_calendar_card"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_20"
    android:paddingTop="@dimen/space_20"
    android:paddingEnd="@dimen/space_20"
    android:paddingBottom="@dimen/space_24">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/apollo_h5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ajustar foto"
            android:textColor="@color/neutral_black" />

        <ImageView
            android:id="@+id/btnCropRotate"
            android:layout_width="@dimen/space_36"
            android:layout_height="@dimen/space_36"
            android:layout_marginEnd="@dimen/space_8"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Girar foto"
            android:padding="@dimen/space_6"
            android:src="@drawable/ic_rotate" />

        <ImageView
            android:id="@+id/btnCropClose"
            android:layout_width="@dimen/space_30"
            android:layout_height="@dimen/space_30"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Fechar"
            android:src="@drawable/ic_close_circle" />
    </LinearLayout>

    <TextView
        style="@style/apollo_body3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:text="Arraste e use dois dedos para ajustar o zoom."
        android:textColor="@color/neutral_gray" />

    <org.apollo.mobile.view.settings.CropImageView
        android:id="@+id/cropView"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_300"
        android:layout_marginTop="@dimen/space_16"
        android:background="#FF1C1C1C" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_20"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCropCancel"
            style="@style/apollo_label3"
            android:layout_width="0dp"
            android:layout_height="@dimen/space_44"
            android:layout_marginEnd="@dimen/space_8"
            android:layout_weight="1"
            android:background="@drawable/bg_cta_outline"
            android:gravity="center"
            android:text="Cancelar"
            android:textColor="@color/cta_outline_text" />

        <TextView
            android:id="@+id/btnCropSave"
            style="@style/apollo_label3"
            android:layout_width="0dp"
            android:layout_height="@dimen/space_44"
            android:layout_weight="1"
            android:background="@drawable/bg_cta_filled"
            android:gravity="center"
            android:text="Salvar foto"
            android:textColor="@color/cta_filled_text" />
    </LinearLayout>
</LinearLayout>
