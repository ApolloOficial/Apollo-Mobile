<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_24"
    android:paddingTop="@dimen/space_16"
    android:paddingEnd="@dimen/space_24"
    android:paddingBottom="@dimen/space_32">

    <View
        android:layout_width="@dimen/space_111"
        android:layout_height="@dimen/space_13"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_sheet_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/apollo_h5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/l_6565ac7f46" />

        <ImageView
            android:id="@+id/btnCloseSheet"
            android:layout_width="@dimen/space_30"
            android:layout_height="@dimen/space_30"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/l_23781b5ede"
            android:src="@drawable/ic_close_circle" />
    </LinearLayout>

    <TextView
        style="@style/apollo_label3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_24"
        android:text="@string/l_95ba3521c3" />

    <EditText
        android:id="@+id/etManualCode"
        style="@style/apollo_body3"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_47"
        android:layout_marginTop="@dimen/space_8"
        android:background="@drawable/bg_input_large"
        android:hint="@string/l_ec6b13bf98"
        android:imeOptions="actionSearch"
        android:inputType="textCapCharacters|textNoSuggestions"
        android:maxLines="1"
        android:paddingStart="@dimen/space_16"
        android:paddingEnd="@dimen/space_16"
        android:textColorHint="@color/disable_gray" />

    <TextView
        android:id="@+id/btnSearchCode"
        style="@style/apollo_button_primary"
        android:layout_height="@dimen/space_52"
        android:layout_marginHorizontal="@dimen/space_minus_8"
        android:layout_marginTop="@dimen/space_16"
        android:enabled="false"
        android:text="@string/l_fb4255d52c" />
</LinearLayout>
