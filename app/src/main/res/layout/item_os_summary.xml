<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_surface_card"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_16"
    android:paddingTop="@dimen/space_24"
    android:paddingEnd="@dimen/space_16"
    android:paddingBottom="@dimen/space_24">

    <TextView
        style="@style/apollo_h6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/complete_maintenance_summary_title" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvVerifiedTag"
            style="@style/apollo_tag"
            android:layout_height="@dimen/space_25"
            android:backgroundTint="@color/sucess_two"
            android:minWidth="@dimen/space_124"
            android:text="@string/l_238c06a9e1" />

        <TextView
            android:id="@+id/tvProblemTag"
            style="@style/apollo_tag"
            android:layout_height="@dimen/space_25"
            android:layout_marginStart="@dimen/space_5"
            android:backgroundTint="@color/error_two"
            android:minWidth="@dimen/space_124"
            android:text="@string/l_6f8bf81905" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/space_14"
        android:background="@color/disable_gray" />

    <LinearLayout
        android:id="@+id/llProblemPlates"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:orientation="vertical" />
</LinearLayout>
