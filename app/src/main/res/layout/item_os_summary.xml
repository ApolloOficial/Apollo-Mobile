<?xml version="1.0" encoding="utf-8"?>
<!-- Card "Resumo": usado na tela de conclusão e na OS concluída -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_os_card"
    android:orientation="vertical"
    android:padding="@dimen/space_16">

    <TextView
        style="@style/apollo_h6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/complete_maintenance_summary_title"
        android:textColor="@color/neutral_black" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_6"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvVerifiedTag"
            style="@style/apollo_label6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_label_rounded"
            android:backgroundTint="@color/sucess_two"
            android:paddingHorizontal="@dimen/space_12"
            android:paddingVertical="@dimen/space_4"
            android:textColor="@color/neutral_black"
            tools:text="2 de 24 verificadas" />

        <TextView
            android:id="@+id/tvProblemTag"
            style="@style/apollo_label6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_6"
            android:background="@drawable/bg_label_rounded"
            android:backgroundTint="@color/error_two"
            android:paddingHorizontal="@dimen/space_12"
            android:paddingVertical="@dimen/space_4"
            android:textColor="@color/neutral_black"
            tools:text="1 com problema" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="@dimen/space_12"
        android:background="#E8E6E1" />

    <!-- Uma linha por placa com problema (TextView com chevron) -->
    <LinearLayout
        android:id="@+id/llProblemPlates"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
