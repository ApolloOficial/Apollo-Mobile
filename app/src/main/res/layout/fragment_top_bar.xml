<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/neutral_white"
    android:paddingHorizontal="@dimen/screen_horizontal_padding"
    android:paddingTop="@dimen/header_top_padding"
    android:paddingBottom="@dimen/header_bottom_padding">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivTopBarProfile"
        android:layout_width="@dimen/header_control_size"
        android:layout_height="@dimen/header_control_size"
        android:contentDescription="Perfil"
        android:scaleType="centerCrop"
        android:src="@drawable/profile_picture"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

    <TextView
        android:id="@+id/tvTopBarLocation"
        style="@style/apollo_label4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/header_item_spacing"
        android:layout_marginEnd="@dimen/header_item_spacing"
        android:background="@drawable/edittext_bg"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:text="Carregando unidade..."
        android:textColor="@color/neutral_black"
        app:layout_constraintBottom_toBottomOf="@id/ivTopBarProfile"
        app:layout_constraintEnd_toStartOf="@id/ibTopBarNotifications"
        app:layout_constraintStart_toEndOf="@id/ivTopBarProfile"
        app:layout_constraintTop_toTopOf="@id/ivTopBarProfile" />

    <ImageButton
        android:id="@+id/ibTopBarNotifications"
        android:layout_width="@dimen/header_control_size"
        android:layout_height="@dimen/header_control_size"
        android:background="@drawable/edittext_bg"
        android:contentDescription="Notificações"
        android:padding="10dp"
        android:src="@drawable/ic_notifications"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
