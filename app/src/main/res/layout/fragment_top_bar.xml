<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/neutral_white"
    android:paddingHorizontal="@dimen/screen_horizontal_padding"
    android:paddingTop="@dimen/space_24"
    android:paddingBottom="@dimen/space_8">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivTopBarProfile"
        android:layout_width="@dimen/header_control_size"
        android:layout_height="@dimen/header_control_size"
        android:contentDescription="@string/l_326ffa2886"
        android:scaleType="centerCrop"
        android:src="@drawable/profile_picture"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

    <TextView
        android:id="@+id/tvTopBarLocation"
        style="@style/apollo_label4"
        android:layout_width="0dp"
        android:layout_height="@dimen/header_location_height"
        android:layout_marginHorizontal="@dimen/header_item_spacing"
        android:background="@drawable/bg_pill_outline"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingHorizontal="@dimen/space_16"
        android:text="@string/l_6a0724dc40"
        android:textColor="@color/neutral_black"
        app:layout_constraintBottom_toBottomOf="@id/ivTopBarProfile"
        app:layout_constraintEnd_toStartOf="@id/ibTopBarNotifications"
        app:layout_constraintStart_toEndOf="@id/ivTopBarProfile"
        app:layout_constraintTop_toTopOf="@id/ivTopBarProfile" />

    <FrameLayout
        android:id="@+id/ibTopBarNotifications"
        android:layout_width="@dimen/header_control_size"
        android:layout_height="@dimen/header_control_size"
        android:background="@drawable/bg_circle_outline"
        android:clickable="true"
        android:contentDescription="@string/l_c5786b6257"
        android:focusable="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivTopBarBell"
            android:layout_width="@dimen/space_24"
            android:layout_height="@dimen/space_24"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_notifications" />

        <View
            android:id="@+id/vTopBarBadge"
            android:layout_width="@dimen/space_10"
            android:layout_height="@dimen/space_10"
            android:layout_gravity="top|end"
            android:layout_marginTop="@dimen/space_10"
            android:layout_marginEnd="@dimen/space_11"
            android:background="@drawable/bg_dot_active"
            android:visibility="gone" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
