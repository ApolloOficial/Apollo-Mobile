<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neutral_white">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/topBar"
        android:name="org.apollo.mobile.view.common.TopBarFragment"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/content_max_width" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintWidth_max="@dimen/content_max_width">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_horizontal_padding"
            android:paddingTop="@dimen/space_16"
            android:paddingEnd="@dimen/screen_horizontal_padding"
            android:paddingBottom="@dimen/content_bottom_padding">

            <TextView
                android:id="@+id/btnBack"
                style="@style/apollo_back" />

            <TextView
                android:id="@+id/tvReportTitle"
                style="@style/apollo_h5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_10"
                android:layout_marginEnd="@dimen/space_72"
                android:text="@string/l_b45119ad86" />

            <TextView
                style="@style/apollo_label3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:text="@string/report_severity" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgSeverity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                app:chipSpacingHorizontal="@dimen/space_8"
                app:chipSpacingVertical="@dimen/space_8" />

            <TextView
                style="@style/apollo_label3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:text="@string/report_type" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                app:chipSpacingHorizontal="@dimen/space_8"
                app:chipSpacingVertical="@dimen/space_8" />

            <TextView
                style="@style/apollo_label3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:text="@string/report_description" />

            <EditText
                android:id="@+id/etDescription"
                style="@style/apollo_label3"
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_79"
                android:layout_marginTop="@dimen/space_4"
                android:background="@drawable/bg_textarea"
                android:gravity="top|start"
                android:hint="@string/l_89cade7692"
                android:inputType="textMultiLine|textCapSentences"
                android:paddingStart="@dimen/space_16"
                android:paddingTop="@dimen/space_16"
                android:paddingEnd="@dimen/space_16"
                android:paddingBottom="@dimen/space_12"
                android:textColorHint="@color/disable_gray" />

            <TextView
                android:id="@+id/btnSend"
                style="@style/apollo_button_primary"
                android:layout_height="@dimen/space_52"
                android:layout_marginTop="@dimen/space_32"
                android:text="@string/report_send" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include layout="@layout/layout_bottom_nav" />

</androidx.constraintlayout.widget.ConstraintLayout>
