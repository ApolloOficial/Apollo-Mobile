<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="@dimen/space_24">

    <TextView
        android:id="@+id/tvInverterGroupName"
        style="@style/apollo_label1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_12"
        android:text="Inversor 001"
        android:textColor="@color/neutral_black" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/neutral_white"
        app:cardCornerRadius="@dimen/space_24"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_20">

            <!-- Header of the Card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/ivInverterIcon"
                    android:layout_width="@dimen/space_40"
                    android:layout_height="@dimen/space_40"
                    android:src="@drawable/ic_solarpanel_black"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvInverterId"
                    style="@style/apollo_label2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:text="ITJ-LIM-001"
                    android:textColor="@color/neutral_black"
                    app:layout_constraintStart_toEndOf="@id/ivInverterIcon"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvInverterDetails"
                    style="@style/apollo_body4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:text="Capac. 42 kWp · 24 placas"
                    android:textColor="@color/neutral_gray"
                    app:layout_constraintStart_toEndOf="@id/ivInverterIcon"
                    app:layout_constraintTop_toBottomOf="@id/tvInverterId" />

                <ImageView
                    android:layout_width="@dimen/space_24"
                    android:layout_height="@dimen/space_24"
                    android:src="@drawable/ic_arrow_back"
                    android:rotation="90"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/neutral_black" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Stats Boxes -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_20"
                android:orientation="horizontal">

                <!-- Stock -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_label_rounded"
                    android:backgroundTint="#F2F2F2"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/space_12">

                    <TextView
                        style="@style/apollo_h5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="04"
                        android:textColor="@color/neutral_black" />

                    <TextView
                        style="@style/apollo_body5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Em estoque"
                        android:textColor="@color/neutral_gray" />
                </LinearLayout>

                <View
                    android:layout_width="@dimen/space_12"
                    android:layout_height="1dp" />

                <!-- In Operation -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_label_rounded"
                    android:backgroundTint="#D1FAE5"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/space_12">

                    <TextView
                        style="@style/apollo_h5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="18"
                        android:textColor="@color/neutral_black" />

                    <TextView
                        style="@style/apollo_body5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Em operação"
                        android:textColor="@color/neutral_gray" />
                </LinearLayout>

                <View
                    android:layout_width="@dimen/space_12"
                    android:layout_height="1dp" />

                <!-- Attention -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_label_rounded"
                    android:backgroundTint="#FEE2E2"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/space_12">

                    <TextView
                        style="@style/apollo_h5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="02"
                        android:textColor="@color/neutral_black" />

                    <TextView
                        style="@style/apollo_body5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Atenção"
                        android:textColor="@color/neutral_gray" />
                </LinearLayout>

            </LinearLayout>

            <!-- Plates List Section -->
            <TextView
                style="@style/apollo_label3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_20"
                android:text="Placas"
                android:textColor="@color/neutral_black" />

            <LinearLayout
                android:id="@+id/llPlatesList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:orientation="vertical">

                <!-- Plate Item Placeholder -->
                <include layout="@layout/item_plate_summary" />
                <include layout="@layout/item_plate_summary" />
                <include layout="@layout/item_plate_summary" />

            </LinearLayout>

            <!-- See All Footer -->
            <TextView
                android:id="@+id/tvSeeAllPlates"
                style="@style/apollo_label3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:gravity="center"
                android:text="Ver todas as 33 placas"
                android:textColor="@color/secondary_three"
                android:background="?attr/selectableItemBackground"
                android:padding="@dimen/space_8"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>
