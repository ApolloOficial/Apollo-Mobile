<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/space_8"
    android:paddingBottom="@dimen/space_8">

    <TextView
        android:id="@+id/tvInverterGroupName"
        style="@style/apollo_h6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_15"
        android:layout_marginBottom="@dimen/space_8"
        android:text="@string/l_87cd65dbc3" />

    <LinearLayout
        android:id="@+id/llCardContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:background="@drawable/bg_surface_card"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_17">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ripple_card"
            android:paddingStart="@dimen/space_16"
            android:paddingTop="@dimen/space_16"
            android:paddingEnd="@dimen/space_16">

            <ImageView
                android:id="@+id/ivInverterIcon"
                android:layout_width="@dimen/space_49"
                android:layout_height="@dimen/space_30"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_inverter_expanded"
                app:layout_constraintBottom_toBottomOf="@id/tvInverterDetails"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvInverterId" />

            <TextView
                android:id="@+id/tvInverterId"
                style="@style/apollo_label2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_16"
                android:layout_marginEnd="@dimen/space_8"
                android:text="@string/l_307299e0a8"
                app:layout_constraintEnd_toStartOf="@id/ivChevron"
                app:layout_constraintStart_toEndOf="@id/ivInverterIcon"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvInverterDetails"
                style="@style/apollo_body3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:text="@string/l_457f04ba2f"
                android:textColor="@color/neutral_gray"
                app:layout_constraintEnd_toEndOf="@id/tvInverterId"
                app:layout_constraintStart_toStartOf="@id/tvInverterId"
                app:layout_constraintTop_toBottomOf="@id/tvInverterId" />

            <ImageView
                android:id="@+id/ivChevron"
                android:layout_width="@dimen/space_24"
                android:layout_height="@dimen/space_24"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_arrow_gray"
                app:layout_constraintBottom_toBottomOf="@id/tvInverterDetails"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvInverterId" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_17"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_37"
            android:paddingEnd="@dimen/space_37">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="@dimen/space_78"
                        android:layout_weight="1"
                        android:background="@drawable/bg_icon_box"
                        android:backgroundTint="#F2F1ED"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvStockCount"
                            style="@style/apollo_h6"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00" />

                        <TextView
                            style="@style/apollo_body4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_3"
                            android:text="@string/l_1783c970b4" />
                    </LinearLayout>

                    <Space
                        android:layout_width="@dimen/space_16"
                        android:layout_height="0dp" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="@dimen/space_78"
                        android:layout_weight="1"
                        android:background="@drawable/bg_icon_box"
                        android:backgroundTint="#D4F8EA"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvOperationCount"
                            style="@style/apollo_h6"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00" />

                        <TextView
                            style="@style/apollo_body4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_3"
                            android:text="@string/l_efa2e9d7d0" />
                    </LinearLayout>

                    <Space
                        android:layout_width="@dimen/space_16"
                        android:layout_height="0dp" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="@dimen/space_78"
                        android:layout_weight="1"
                        android:background="@drawable/bg_icon_box"
                        android:backgroundTint="#FDD5D5"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvAttentionCount"
                            style="@style/apollo_h6"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00" />

                        <TextView
                            style="@style/apollo_body4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_3"
                            android:text="@string/l_d45f3feee7" />
                    </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llHealthRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_53"
            android:paddingEnd="@dimen/space_53">

            <TextView
                style="@style/apollo_label4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/l_4e63f92eb3" />

            <TextView
                android:id="@+id/tvHealthValue"
                style="@style/apollo_body4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="87%" />
        </LinearLayout>

        <TextView
            style="@style/apollo_label4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_53"
            android:layout_marginTop="@dimen/space_18"
            android:text="@string/l_1a1a776e9f" />

        <LinearLayout
            android:id="@+id/llPlatesList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_53"
            android:paddingEnd="@dimen/space_53" />

        <TextView
            android:id="@+id/tvSeeAllPlates"
            style="@style/apollo_label2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/space_12"
            android:layout_marginEnd="@dimen/space_53"
            android:layout_marginBottom="@dimen/space_7"
            android:background="@drawable/ripple_card"
            android:text="@string/l_bbf29a4909"
            android:textColor="@color/secondary_three" />
    </LinearLayout>

</LinearLayout>
