<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neutral_white">

    <LinearLayout
        android:id="@+id/clHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_24"
        android:paddingTop="@dimen/space_34"
        android:paddingBottom="@dimen/space_15"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/btnBack"
            style="@style/apollo_back" />
    </LinearLayout>

    <View
        android:id="@+id/headerDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/disable_gray"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/clHeader" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerDivider"
        app:layout_constraintWidth_max="@dimen/content_max_width">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_23"
            android:paddingTop="@dimen/space_40"
            android:paddingEnd="@dimen/space_23"
            android:paddingBottom="@dimen/space_32">

            <ImageView
                android:id="@+id/ivSuccessIcon"
                android:layout_width="@dimen/space_58"
                android:layout_height="@dimen/space_58"
                android:layout_gravity="center_horizontal"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_check_green" />

            <TextView
                android:id="@+id/tvTitle"
                style="@style/apollo_h5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_8"
                android:text="Placa identificada!" />

            <TextView
                android:id="@+id/tvSubtitle"
                style="@style/apollo_body2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_2"
                android:text="Dados abaixo vieram do scan"
                android:textColor="@color/neutral_gray" />

            <LinearLayout
                android:id="@+id/llInfoRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:orientation="horizontal">

                <TextView
                    style="@style/apollo_label2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Número de série"
                    android:textColor="@color/neutral_gray" />

                <TextView
                    style="@style/apollo_label2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_16"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:maxLines="1"
                    android:text="CS-2026-00932" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:orientation="horizontal">

                <TextView
                    style="@style/apollo_label2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Modelo"
                    android:textColor="@color/neutral_gray" />

                <TextView
                    style="@style/apollo_label2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_16"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:maxLines="1"
                    android:text="Canadian CS3W-410P" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:orientation="horizontal">

                <TextView
                    style="@style/apollo_label2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Potência de etiqueta"
                    android:textColor="@color/neutral_gray" />

                <TextView
                    style="@style/apollo_label2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_16"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:maxLines="1"
                    android:text="410W" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:orientation="horizontal">

                <TextView
                    style="@style/apollo_label2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Inversor / String"
                    android:textColor="@color/neutral_gray" />

                <TextView
                    style="@style/apollo_label2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_16"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:maxLines="1"
                    android:text="Inversor 002 / ITJ-LIM-001" />
            </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/apollo_label1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:text="Preencha para ativar a placa" />

            <TextView
                style="@style/apollo_body3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6"
                android:text="Confirme os dados de instalação desta placa"
                android:textColor="@color/neutral_gray" />

            <TextView
                style="@style/apollo_label3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:text="Data de instalação" />

            <LinearLayout
                android:id="@+id/llInstallationDate"
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_47"
                android:layout_marginTop="@dimen/space_3"
                android:background="@drawable/bg_input_large"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_24"
                android:paddingEnd="@dimen/space_16">

                <ImageView
                    android:layout_width="@dimen/space_24"
                    android:layout_height="@dimen/space_24"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_calendar" />

                <TextView
                    android:id="@+id/tvInstallationDate"
                    style="@style/apollo_label3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_16"
                    android:layout_weight="1"
                    android:hint="Insira a data de instalação"
                    android:textColorHint="@color/disable_gray" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:background="@drawable/bg_surface_card"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_16"
                android:paddingTop="@dimen/space_24"
                android:paddingEnd="@dimen/space_16"
                android:paddingBottom="@dimen/space_24">

                <TextView
                    android:id="@+id/tvPositionTitle"
                    style="@style/apollo_label1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Inversor ITJ-LIM-002, String 02" />

                <TextView
                    android:id="@+id/tvPositionSubtitle"
                    style="@style/apollo_body4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="Essa string já tem 13 das 25 placas instaladas"
                    android:textColor="@color/neutral_gray" />

                <TextView
                    style="@style/apollo_label4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:text="Defina a posição desta placa na string:" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/space_16"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/btnMinus"
                        android:layout_width="@dimen/space_30"
                        android:layout_height="@dimen/space_30"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Diminuir posição"
                        android:src="@drawable/ic_stepper_minus" />

                    <TextView
                        android:id="@+id/tvPositionValue"
                        style="@style/apollo_h3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/space_24"
                        android:text="14 de 24" />

                    <ImageView
                        android:id="@+id/btnPlus"
                        android:layout_width="@dimen/space_30"
                        android:layout_height="@dimen/space_30"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Aumentar posição"
                        android:src="@drawable/ic_stepper_plus" />
                </LinearLayout>

                <TextView
                    style="@style/apollo_body4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:text="Sugerida: próxima posição livre na ordem do bipe."
                    android:textColor="@color/neutral_gray" />

                <TextView
                    style="@style/apollo_body4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:lineSpacingExtra="@dimen/space_2"
                    android:text="Bipe na ordem física da fileira: a posição é sugerida sozinha (próxima livre). Use − / + só para corrigir.\nNão é mais preciso digitar eficiência inicial"
                    android:textColor="@color/neutral_gray" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnConfirmActivation"
                style="@style/apollo_button_primary"
                android:layout_height="@dimen/space_52"
                android:layout_marginHorizontal="@dimen/space_minus_7"
                android:layout_marginTop="@dimen/space_24"
                android:text="Confirmar e ativar placa" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
