<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/ivBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_login" />

    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="@dimen/logo_width"
        android:layout_height="@dimen/logo_height"
        android:layout_marginStart="@dimen/logo_margin_start"
        android:layout_marginTop="@dimen/logo_margin_top"
        android:src="@drawable/logo_white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_white"
        android:paddingStart="@dimen/card_padding_horizontal"
        android:paddingEnd="@dimen/card_padding_horizontal"
        android:paddingTop="@dimen/card_padding_top"
        android:paddingBottom="@dimen/card_padding_bottom"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tvTitle"
            style="@style/apollo_h4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Crie uma nova senha"
            android:textColor="@color/neutral_black"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvPasswordLabel"
            style="@style/apollo_label3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Senha"
            android:textColor="@color/neutral_black"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <EditText
            android:id="@+id/etNewPassword"
            style="@style/apollo_body3"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/edittext_bg"
            android:drawableStart="@drawable/ic_lock"
            android:drawableEnd="@drawable/ic_eye"
            android:drawablePadding="12dp"
            android:hint="Digite aqui sua senha"
            android:inputType="textPassword"
            android:paddingHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvPasswordLabel" />

        <TextView
            android:id="@+id/tvConfirmPasswordLabel"
            style="@style/apollo_label3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Confirmar senha"
            android:textColor="@color/neutral_black"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etNewPassword" />

        <EditText
            android:id="@+id/etConfirmPassword"
            style="@style/apollo_body3"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/edittext_bg"
            android:drawableStart="@drawable/ic_lock"
            android:drawableEnd="@drawable/ic_eye"
            android:drawablePadding="12dp"
            android:hint="Digite aqui sua senha"
            android:inputType="textPassword"
            android:paddingHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvConfirmPasswordLabel" />

        <TextView
            android:id="@+id/tvRequirements"
            style="@style/apollo_body4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="8dp"
            android:lineSpacingExtra="4dp"
            android:text="• Mínimo 8 caracteres;\n• Pelo menos 1 letra maiúscula e 1 minúscula;\n• 1 número;\n• 1 caractere especial"
            android:textColor="@color/neutral_gray"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etConfirmPassword" />

        <Button
            android:id="@+id/btnResetPassword"
            style="@style/apollo_label2"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/secondary_three"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Continuar"
            android:textAllCaps="false"
            android:textColor="@color/neutral_white"
            app:cornerRadius="28dp"
            app:layout_constraintTop_toBottomOf="@id/tvRequirements" />

        <Button
            android:id="@+id/btnBack"
            style="@style/apollo_label2"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/btn_outlined"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Voltar"
            android:textAllCaps="false"
            android:textColor="@color/neutral_black"
            app:backgroundTint="@null"
            app:cornerRadius="28dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnResetPassword" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>