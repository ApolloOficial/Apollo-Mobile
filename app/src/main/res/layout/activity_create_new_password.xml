<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/ivBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_login" />

    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="@dimen/logo_width"
        android:layout_height="@dimen/logo_height"
        android:layout_marginStart="@dimen/logo_margin_start"
        android:layout_marginTop="@dimen/logo_margin_top"
        android:src="@drawable/logo_white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_white"
        android:paddingStart="@dimen/card_padding_horizontal"
        android:paddingEnd="@dimen/card_padding_horizontal"
        android:paddingTop="@dimen/card_padding_top"
        android:paddingBottom="@dimen/card_padding_bottom"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tvTitle"
            style="@style/apollo_auth_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/l_7df4fd2af7"
            android:textColor="@color/neutral_black"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvPasswordLabel"
            style="@style/apollo_label3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/l_ff64a1c434"
            android:textColor="@color/neutral_black"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <EditText
            android:id="@+id/etNewPassword"
            style="@style/apollo_body3"
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_52"
            android:layout_marginTop="@dimen/space_4"
            android:background="@drawable/edittext_bg"
            android:drawableStart="@drawable/ic_lock"
            android:drawableEnd="@drawable/ic_eye"
            android:drawablePadding="@dimen/space_12"
            android:hint="@string/l_774199645e"
            android:inputType="textPassword"
            android:paddingHorizontal="@dimen/space_16"
            app:layout_constraintTop_toBottomOf="@id/tvPasswordLabel" />

        <TextView
            android:id="@+id/tvConfirmPasswordLabel"
            style="@style/apollo_label3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:text="@string/l_f01ca6de96"
            android:textColor="@color/neutral_black"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etNewPassword" />

        <EditText
            android:id="@+id/etConfirmPassword"
            style="@style/apollo_body3"
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_52"
            android:layout_marginTop="@dimen/space_4"
            android:background="@drawable/edittext_bg"
            android:drawableStart="@drawable/ic_lock"
            android:drawableEnd="@drawable/ic_eye"
            android:drawablePadding="@dimen/space_12"
            android:hint="@string/l_774199645e"
            android:inputType="textPassword"
            android:paddingHorizontal="@dimen/space_16"
            app:layout_constraintTop_toBottomOf="@id/tvConfirmPasswordLabel" />

        <TextView
            android:id="@+id/tvRequirements"
            style="@style/apollo_body4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:layout_marginStart="@dimen/space_8"
            android:lineSpacingExtra="@dimen/space_4"
            android:text="@string/l_66bfb9aa61"
            android:textColor="@color/neutral_gray"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etConfirmPassword" />

        <Button
            android:id="@+id/btnResetPassword"
            style="@style/apollo_label2"
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_52"
            android:layout_marginTop="@dimen/space_24"
            app:backgroundTint="@color/cta_fill_tint"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/l_64b467714a"
            android:textAllCaps="false"
            android:textColor="@color/cta_filled_text"
            app:cornerRadius="@dimen/space_28"
            app:layout_constraintTop_toBottomOf="@id/tvRequirements" />

        <Button
            android:id="@+id/btnBack"
            style="@style/apollo_label2"
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_52"
            android:layout_marginTop="@dimen/space_12"
            android:layout_marginBottom="@dimen/space_8"
            android:background="@drawable/btn_outlined"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/l_04b2b63394"
            android:textAllCaps="false"
            android:textColor="@color/neutral_black"
            app:backgroundTint="@null"
            app:cornerRadius="@dimen/space_28"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnResetPassword" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>