<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_calendar_card"
    android:orientation="vertical"
    android:padding="@dimen/space_20">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnCalPrev"
            android:layout_width="@dimen/space_32"
            android:layout_height="@dimen/space_32"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Mês anterior"
            android:padding="@dimen/space_4"
            android:src="@drawable/ic_cal_prev" />

        <TextView
            android:id="@+id/tvCalMonth"
            style="@style/apollo_h6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/manrope_bold"
            android:gravity="center"
            android:text="outubro de 2026"
            android:textColor="@color/neutral_black" />

        <ImageView
            android:id="@+id/btnCalNext"
            android:layout_width="@dimen/space_32"
            android:layout_height="@dimen/space_32"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Próximo mês"
            android:padding="@dimen/space_4"
            android:src="@drawable/ic_cal_next" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llCalWeekdays"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:orientation="horizontal" />

    <LinearLayout
        android:id="@+id/llCalDays"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:orientation="vertical" />
</LinearLayout>
