<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neutral_white"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_24"
        android:paddingTop="@dimen/space_34"
        android:paddingEnd="@dimen/space_24"
        android:paddingBottom="@dimen/space_32">

        <TextView
            android:id="@+id/tvBack"
            style="@style/apollo_back" />

        <TextView
            style="@style/apollo_h4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_10"
            android:text="Meu perfil" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_profile_large"
            android:layout_width="@dimen/space_100"
            android:layout_height="@dimen/space_100"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_16"
            android:padding="1dp"
            android:scaleType="centerCrop"
            android:src="@drawable/profile_picture"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize50Percent"
            app:strokeColor="@color/disable_gray"
            app:strokeWidth="2dp" />

        <TextView
            android:id="@+id/btn_change_photo"
            style="@style/apollo_label3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_8"
            android:background="@drawable/ripple_card"
            android:text="Editar foto"
            android:textColor="@color/secondary_three" />

            <TextView
                style="@style/apollo_field_label"
                android:text="Nome completo" />

            <TextView
                android:id="@+id/tv_name_value"
                style="@style/apollo_field"
                android:text="Usuário" />

            <TextView
                style="@style/apollo_field_label"
                android:text="E-mail" />

            <TextView
                android:id="@+id/tv_email_value"
                style="@style/apollo_field"
                android:text="usuario@email.com" />

            <TextView
                style="@style/apollo_field_label"
                android:text="Empresa" />

            <TextView
                android:id="@+id/tv_company_value"
                style="@style/apollo_field"
                android:text="Fábrica Itajaí, Limeira - SP" />

            <TextView
                style="@style/apollo_field_label"
                android:text="Cargo" />

            <TextView
                android:id="@+id/tv_role_value"
                style="@style/apollo_field"
                android:text="Técnico de Manutenção" />

        <TextView
            android:id="@+id/tv_info_footer"
            style="@style/apollo_info_box"
            android:layout_marginTop="@dimen/space_24"
            android:text="@string/settings_profile_footer" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
