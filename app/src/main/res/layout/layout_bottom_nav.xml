<?xml version="1.0" encoding="utf-8"?>
<merge
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="androidx.constraintlayout.widget.ConstraintLayout">

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabChatbot"
        android:layout_width="@dimen/chatbot_size"
        android:layout_height="@dimen/chatbot_size"
        android:layout_marginEnd="@dimen/chatbot_margin_end"
        android:layout_marginBottom="@dimen/chatbot_margin_bottom"
        android:contentDescription="Abrir chatbot"
        android:src="@drawable/ic_chatbot"
        app:backgroundTint="@color/secondary_three"
        app:elevation="@dimen/space_6"
        app:fabCustomSize="@dimen/chatbot_size"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:maxImageSize="@dimen/chatbot_icon_size"
        app:rippleColor="@color/ripple_white"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
        app:tint="@color/neutral_white" />

    <androidx.cardview.widget.CardView
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="@dimen/bottom_nav_height"
        android:layout_marginHorizontal="@dimen/bottom_nav_horizontal_margin"
        android:layout_marginBottom="@dimen/bottom_nav_bottom_margin"
        app:cardBackgroundColor="@color/surface_white"
        app:cardCornerRadius="@dimen/bottom_nav_radius"
        app:cardElevation="@dimen/space_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_max="@dimen/content_max_width">

        <FrameLayout
            android:id="@+id/navContainer"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/scanner_button_size"
            android:layout_gravity="center">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/llHome"
                    android:layout_width="@dimen/bottom_nav_icon_size"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Início">

                    <ImageView
                        android:id="@+id/ivHome"
                        android:layout_width="@dimen/bottom_nav_icon_size"
                        android:layout_height="@dimen/bottom_nav_icon_size"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_home_gray" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/llPanels"
                    android:layout_width="@dimen/bottom_nav_icon_size"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/bottom_nav_item_spacing"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Placas">

                    <ImageView
                        android:id="@+id/ivPanels"
                        android:layout_width="@dimen/bottom_nav_icon_size"
                        android:layout_height="@dimen/bottom_nav_icon_size"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_solarpanel_gray" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/cvScanContainer"
                    android:layout_width="@dimen/scanner_button_size"
                    android:layout_height="@dimen/scanner_button_size"
                    android:layout_marginStart="@dimen/bottom_nav_item_spacing"
                    android:background="@drawable/bg_scanner_button"
                    android:contentDescription="Escanear placa">

                    <ImageView
                        android:id="@+id/ivScan"
                        android:layout_width="@dimen/scanner_icon_size"
                        android:layout_height="@dimen/scanner_icon_size"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_scan" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/llTools"
                    android:layout_width="@dimen/bottom_nav_icon_size"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/bottom_nav_item_spacing"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Manutenção">

                    <ImageView
                        android:id="@+id/ivTools"
                        android:layout_width="@dimen/bottom_nav_icon_size"
                        android:layout_height="@dimen/bottom_nav_icon_size"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_tools_gray" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/llSettings"
                    android:layout_width="@dimen/bottom_nav_icon_size"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/bottom_nav_item_spacing"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Configurações">

                    <ImageView
                        android:id="@+id/ivSettings"
                        android:layout_width="@dimen/bottom_nav_icon_size"
                        android:layout_height="@dimen/bottom_nav_icon_size"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_settings_gray" />
                </FrameLayout>
            </LinearLayout>

            <View
                android:id="@+id/navIndicator"
                android:layout_width="@dimen/bottom_nav_indicator_width"
                android:layout_height="@dimen/bottom_nav_indicator_height"
                android:layout_gravity="top|start"
                android:layout_marginTop="@dimen/space_58"
                android:background="@drawable/bg_indicator_home"
                android:visibility="invisible" />
        </FrameLayout>

    </androidx.cardview.widget.CardView>

</merge>
