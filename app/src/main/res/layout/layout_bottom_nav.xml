<?xml version="1.0" encoding="utf-8"?>
<!--
    Footer + botão do chatbot reutilizáveis (medidas da activity_home).
    Uso: dentro de um ConstraintLayout raiz →
        <include layout="@layout/layout_bottom_nav" />
    O conteúdo rolável da tela deve usar app:layout_constraintBottom_toTopOf="@id/bottomNavigation".
    Aba ativa e cliques: BottomNavigation.setup(this, BottomNavigation.Tab.X)
-->
<merge
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="androidx.constraintlayout.widget.ConstraintLayout">

    <!-- Botão Chatbot Circular -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabChatbot"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="Abrir chatbot"
        android:src="@drawable/ic_chatbot"
        app:backgroundTint="@color/secondary_three"
        app:fabCustomSize="80dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:maxImageSize="36dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
        app:tint="@color/neutral_white" />

    <!-- Navigation Footer -->
    <androidx.cardview.widget.CardView
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="91dp"
        android:layout_marginHorizontal="8dp"
        android:layout_marginBottom="20dp"
        app:cardCornerRadius="32dp"
        app:cardElevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Início -->
            <LinearLayout
                android:id="@+id/llHome"
                android:layout_width="34dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivHome"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:contentDescription="Início"
                    android:src="@drawable/ic_home_gray" />

                <View
                    android:id="@+id/indicatorHome"
                    android:layout_width="34dp"
                    android:layout_height="6dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_indicator_home"
                    android:visibility="invisible" />
            </LinearLayout>

            <!-- Placas -->
            <LinearLayout
                android:id="@+id/llPanels"
                android:layout_width="34dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivPanels"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:contentDescription="Placas"
                    android:src="@drawable/ic_solarpanel_gray" />

                <View
                    android:id="@+id/indicatorPanels"
                    android:layout_width="34dp"
                    android:layout_height="6dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_indicator_home"
                    android:visibility="invisible" />
            </LinearLayout>

            <!-- Scanner -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cvScanContainer"
                android:layout_width="73dp"
                android:layout_height="73dp"
                android:layout_marginStart="24dp"
                android:contentDescription="Escanear placa"
                app:cardBackgroundColor="@color/secondary_three"
                app:cardCornerRadius="36.5dp"
                app:cardElevation="0dp">

                <ImageView
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_scan"
                    app:tint="@color/neutral_white" />
            </androidx.cardview.widget.CardView>

            <!-- Manutenção -->
            <LinearLayout
                android:id="@+id/llTools"
                android:layout_width="34dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivTools"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:contentDescription="Manutenção"
                    android:src="@drawable/ic_tools_gray" />

                <View
                    android:id="@+id/indicatorTools"
                    android:layout_width="34dp"
                    android:layout_height="6dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_indicator_home"
                    android:visibility="invisible" />
            </LinearLayout>

            <!-- Configurações -->
            <LinearLayout
                android:id="@+id/llSettings"
                android:layout_width="34dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivSettings"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:contentDescription="Configurações"
                    android:src="@drawable/ic_settings_gray" />

                <View
                    android:id="@+id/indicatorSettings"
                    android:layout_width="34dp"
                    android:layout_height="6dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_indicator_home"
                    android:visibility="invisible" />
            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</merge>
